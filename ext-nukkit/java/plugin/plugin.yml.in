# Stratum's Nukkit plugin. Configured by ext-nukkit/CMakeLists.txt.
name: Stratum
main: stratum.nukkit.StratumPlugin
version: "@PROJECT_VERSION@"
api: ["1.0.0"]
# STARTUP: the generator is registered, and new worlds' pipelines frozen,
# before Nukkit loads or creates any world.
load: STARTUP
author: the Stratum contributors
description: "Vanilla Java @STRATUM_MINECRAFT_VERSION@ terrain for Nukkit, generated by the Stratum engine"
