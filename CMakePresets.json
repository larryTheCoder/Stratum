{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "STRATUM_BUILD_CLI": "ON",
        "STRATUM_BUILD_TESTS": "ON",
        "STRATUM_BUILD_EXT": "OFF"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "dev (Debug, warnings not fatal)",
      "description": "Default local development configuration. No generator is pinned, so it works with Make, Ninja or Visual Studio.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "STRATUM_WERROR": "OFF"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "release (RelWithDebInfo)",
      "description": "Optimised build with debug info. Determinism flags are identical to dev by construction.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "STRATUM_WERROR": "OFF"
      }
    },
    {
      "name": "ci-debug",
      "inherits": "base",
      "displayName": "ci-debug (warnings are errors)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "STRATUM_WERROR": "ON"
      },
      "description": "CI configuration: warnings are errors. No generator is pinned so each platform uses its native default (Make, Ninja or MSBuild)."
    },
    {
      "name": "ci-release",
      "inherits": "base",
      "displayName": "ci-release (warnings are errors)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "STRATUM_WERROR": "ON"
      },
      "description": "CI configuration: warnings are errors. No generator is pinned so each platform uses its native default (Make, Ninja or MSBuild)."
    },
    {
      "name": "ext",
      "displayName": "PocketMine-MP zend module",
      "description": "Debug, warnings as errors, with ext/'s zend module. Needs STRATUM_PHP_CONFIG in the environment: STRATUM_PHP_CONFIG=$(tools/php-dev --print-config) cmake --preset ext",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "STRATUM_WERROR": "ON",
        "STRATUM_BUILD_EXT": "ON",
        "STRATUM_PHP_CONFIG": "$env{STRATUM_PHP_CONFIG}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug"
    },
    {
      "name": "ci-conformance",
      "configurePreset": "dev",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "ci-debug",
      "configurePreset": "ci-debug",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release",
      "configuration": "RelWithDebInfo",
      "jobs": 4
    },
    {
      "name": "ext",
      "configurePreset": "ext",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug",
      "displayName": "unit + lint",
      "description": "Fast hermetic suites. This is the gate CLAUDE.md requires green before anything is done.",
      "filter": {
        "include": {
          "label": "unit|lint"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "conformance",
      "configurePreset": "dev",
      "configuration": "Debug",
      "displayName": "Tier-A golden diffs vs vanilla",
      "description": "Requires locally generated fixtures; skips loudly when they are absent. An hour per case, as CI allows: with the goldens present three cases outrun include(CTest)'s 1500 s default on a loaded 4-core machine.",
      "filter": {
        "include": {
          "label": "conformance"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 3600
      }
    },
    {
      "name": "ci-conformance",
      "inherits": "conformance",
      "displayName": "conformance, as CI runs it",
      "description": "The conformance suite four cases at a time, an hour per case: with the probe worlds present it is about 70 minutes of Debug test time serially, and its longest case has measured 1237 s against include(CTest)'s 1500 s default.",
      "execution": {
        "noTestsAction": "error",
        "jobs": 4,
        "timeout": 3600
      }
    },
    {
      "name": "ci-debug",
      "configurePreset": "ci-debug",
      "configuration": "Debug",
      "filter": {
        "include": {
          "label": "unit|lint"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release",
      "configuration": "RelWithDebInfo",
      "filter": {
        "include": {
          "label": "unit|lint"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ext",
      "configurePreset": "ext",
      "configuration": "Debug",
      "filter": {
        "include": {
          "label": "ext"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
