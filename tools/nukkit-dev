#!/usr/bin/env bash
# Stratum — a CloudburstMC/Nukkit server to build and run ext-nukkit/ against.
#
# ext-nukkit/'s plugin is compiled against, and smoke-tested inside, a real
# Nukkit server. The one thing this script downloads is that server: ONE
# prebuilt jar built by CloudburstMC — from its own CI (the NukkitX/Nukkit
# master job), or from its Maven snapshot repository, which its GitHub
# deploy job publishes to on every master push (owner, 2026-10-27, when the
# CI answered HTTP 502 for every job) — at the build pinned below, checked
# against the SHA-256 recorded below and refused on any mismatch. Nothing
# from the download is run but the jar itself; Nukkit is never built from
# source here. No root, no JDK download.
#
# Usage:
#   tools/nukkit-dev                    # the pin, where everything lives, what is present
#   tools/nukkit-dev fetch              # install the pinned jar once, verified
#   tools/nukkit-dev --print-jar        # the verified jar's path (exit 1 if absent)
#   tools/nukkit-dev --print-java-home  # a local JDK with javac and jni.h
#   tools/nukkit-dev pin <build>        # owner only: download CI build <build>'s jar
#                                       # into quarantine and print the lines to pin it
#   tools/nukkit-dev pin-maven <version>
#                                       # owner only: the same, for a Maven snapshot
#                                       # version (1.0-<timestamp>-<n>) of cn.nukkit:nukkit
#   tools/nukkit-dev server <dir> --plugin <jar> --pack <version root> [options]
#                                       # write a server directory (NOT hermetic on its own)
#   tools/nukkit-dev smoke --plugin <jar> --smoke-plugin <jar> --library <so>
#                          --pack <version root> [options]
#                                       # the headless smoke run (ext-nukkit.smoke)
#   tools/nukkit-dev scan-log <log> [world]  # smoke's check of one Nukkit log
#
# Everything lives under $STRATUM_NUKKIT_DIR (default ~/stratum-work/nukkit):
# jars/ the verified jar, quarantine/ what `pin` downloaded, servers/ the
# server directories `smoke` writes ($STRATUM_NUKKIT_SERVER_DIR moves the
# smoke server elsewhere: ~/stratum-work is an exFAT disk, and should Nukkit's
# LevelDB misbehave there, ~/.cache/stratum-nukkit/smoke is the place to put
# it). Idempotent: a verified jar is reused, `server` rewrites only its
# configuration, `smoke` starts from an empty directory each time.
#
# KEEP THE VERIFIED JAR. CloudburstMC's CI keeps the artifacts of its newest
# five builds only (Nukkit's Jenkinsfile: buildDiscarder(logRotator(
# artifactNumToKeepStr: '5'))), so five builds after the pinned one its jar
# is gone from the CI for good, and `fetch` can only answer 404. A snapshot
# repository prunes old snapshots too. The copy in
# $STRATUM_NUKKIT_DIR/jars (or quarantine/) is then the only one: keep it, or
# a backup of it. `fetch` installs any file at the jar's path whose SHA-256
# is the pin, wherever it came from; without one, the way on is a re-pin.
#
# NETWORK. `server` turns off every switch Nukkit has that listens or talks
# (read from Nukkit at the pinned commit, SPEC §11's M5-Nukkit entry): it
# binds 127.0.0.1 on a non-default port; query, RCON and bStats are off;
# nobody is whitelisted. That does NOT make a server hermetic: Nukkit's
# Server constructor fetches Microsoft's Bedrock auth discovery document
# (client.discovery.minecraft-services.net) and the OpenID configuration it
# names on every start, whatever the configuration (EncryptionUtils), and
# without either, and without a cached copy, it stops. `server` writes
# synthetic caches of both (discovery-cache.json, openid-cache.json) naming
# only auth.invalid, so it starts when those fetches fail; but a server
# started from that directory with network access still fetches the real
# documents first, and overwrites the caches. Only `smoke` is hermetic: it
# runs Nukkit in a network namespace of its own (unshare -rn) holding
# loopback alone, so nothing it does can reach any other host, and the two
# failed fetches are the two errors its log check expects (no other).
set -euo pipefail

# --- The pin ----------------------------------------------------------------
# Set together, from `tools/nukkit-dev pin <build>`'s or `pin-maven
# <version>`'s output, by the owner. Empty until then, and `fetch` refuses to
# download anything without them. NUKKIT_BUILD names the build (a CI build
# number or a Maven snapshot version), NUKKIT_URL is where `fetch` gets it.
readonly NUKKIT_CI_JOB="https://ci.opencollab.dev/job/NukkitX/job/Nukkit/job/master"
readonly NUKKIT_MAVEN="https://repo.opencollab.dev/maven-snapshots/cn/nukkit/nukkit/1.0-SNAPSHOT"
readonly NUKKIT_BUILD="1.0-20260919.123832-1250"
readonly NUKKIT_COMMIT="b3caad67d86be34aeca3937e64e8176f6760a2d4"
readonly NUKKIT_URL="https://repo.opencollab.dev/maven-snapshots/cn/nukkit/nukkit/1.0-SNAPSHOT/nukkit-1.0-20260919.123832-1250.jar"
readonly NUKKIT_SHA256="b373dcdb240d0d32fccbc9e0f9e727c4591082580dad7d522f924b7b411daa49"
# The commit this binding was read against (CloudburstMC/Nukkit master,
# 2026-09-19, Bedrock 26.50). Prefer the CI build of exactly this commit.
readonly NUKKIT_READ_AT="b3caad67d86be34aeca3937e64e8176f6760a2d4"
# How many builds' artifacts the CI keeps (the Jenkinsfile's logRotator).
readonly NUKKIT_CI_KEEPS=5

readonly nukkit_dir="${STRATUM_NUKKIT_DIR:-${HOME}/stratum-work/nukkit}"

# What `smoke` writes into a server directory it makes, and requires before
# it empties one: it never deletes a directory it did not make.
readonly smoke_marker=".stratum-nukkit-smoke"

# Whether `server` warns that its directory is not hermetic on its own;
# `smoke`, which runs it hermetically, turns this off.
server_note=1

# The two startup fetches Nukkit makes whatever its configuration
# (EncryptionUtils), as its log names them; the second is the synthetic
# discovery cache's own host.
readonly auth_discovery_url="https://client.discovery.minecraft-services.net/api/v1.0/discovery/MinecraftPE/builds/1.0.0.0"
readonly auth_openid_url="https://auth.invalid/.well-known/openid-configuration"

log() { printf '==> %s\n' "$*" >&2; }
die() { printf 'nukkit-dev: %s\n' "$*" >&2; exit 1; }

jar_path() { printf '%s/jars/nukkit-%s.jar' "${nukkit_dir}" "${NUKKIT_BUILD}"; }

pinned() { [[ -n "${NUKKIT_BUILD}" && -n "${NUKKIT_URL}" && -n "${NUKKIT_SHA256}" ]]; }

sha256_of() { sha256sum "$1" | cut -d' ' -f1; }

# Exit status 0 when $1 is the pinned jar, byte for byte.
verified() { pinned && [[ -f "$1" ]] && [[ "$(sha256_of "$1")" == "${NUKKIT_SHA256}" ]]; }

require_pin() {
    pinned || die "no Nukkit build is pinned yet. The owner runs 'tools/nukkit-dev pin <build>' \
(a build of ${NUKKIT_CI_JOB}, preferably the one of commit ${NUKKIT_READ_AT}) and copies the \
four lines it prints into this script."
}

# Downloads $1 into $2 over HTTPS only (redirects included). Prints the HTTP
# status; exit status 0 only for a 200.
download() { # url target
    local code
    code="$(curl --location --proto '=https' --proto-redir '=https' --tlsv1.2 --silent --show-error \
        --connect-timeout 30 --max-time 900 --output "$2" --write-out '%{http_code}' "$1")" || true
    printf '%s' "${code:-000}"
    [[ "${code}" == 200 ]]
}

# The reason a CI download did not answer 200, for a message.
ci_refusal() { # http-code build
    if [[ "$1" == 404 ]]; then
        printf '%s' "HTTP 404: build $2's artifacts are gone. CloudburstMC's CI keeps the artifacts \
of its newest ${NUKKIT_CI_KEEPS} builds only (Nukkit's Jenkinsfile, logRotator artifactNumToKeepStr \
'${NUKKIT_CI_KEEPS}'), so a pinned build's jar is deleted ${NUKKIT_CI_KEEPS} builds later. Put the \
kept copy of the verified jar at $(jar_path) (any file there whose SHA-256 is the pin is \
accepted), or re-pin a current build"
    else
        printf '%s' "CloudburstMC's CI answered HTTP $1 for build $2 (000: no answer at all)"
    fi
}

# The reason fetching the pinned jar did not answer 200: the CI's own
# message for a CI pin, the URL and status for any other.
fetch_refusal() { # http-code
    if [[ "${NUKKIT_URL}" == "${NUKKIT_CI_JOB}/"* ]]; then
        ci_refusal "$1" "${NUKKIT_BUILD}"
    else
        printf '%s' "${NUKKIT_URL} answered HTTP $1 (000: no answer at all). Put the kept copy of \
the verified jar at $(jar_path) (any file there whose SHA-256 is the pin is accepted), or re-pin"
    fi
}

# --- JDK ----------------------------------------------------------------------

java_home_ok() { [[ -x "$1/bin/javac" && -x "$1/bin/java" && -f "$1/include/jni.h" && -f "$1/lib/ct.sym" ]]; }

find_java_home() {
    if [[ -n "${JAVA_HOME:-}" ]] && java_home_ok "${JAVA_HOME}"; then
        printf '%s\n' "${JAVA_HOME}"
        return 0
    fi
    # The newest Java version first, by each JDK's own `release` file. A JDK,
    # not a JRE: javac for the classes, jni.h for the shim, ct.sym for
    # --release 8 (Nukkit's floor).
    local candidate version
    while IFS=' ' read -r version candidate; do
        if java_home_ok "${candidate}"; then
            printf '%s\n' "${candidate}"
            return 0
        fi
    done < <(find /usr/lib/jvm "${HOME}/.jdks" -mindepth 1 -maxdepth 1 -type d 2>/dev/null |
        while IFS= read -r candidate; do
            version="$(sed -n 's/^JAVA_VERSION="\(.*\)"$/\1/p' "${candidate}/release" 2>/dev/null)"
            printf '%s %s\n' "${version:-0}" "${candidate}"
        done | sort -rV)
    return 1
}

# --- Subcommands ----------------------------------------------------------------

cmd_status() {
    if pinned; then
        echo "pinned:   build ${NUKKIT_BUILD} (commit ${NUKKIT_COMMIT:-unrecorded})"
        echo "          ${NUKKIT_URL}, sha256 ${NUKKIT_SHA256}"
        echo "          (neither source keeps a build for ever: keep the verified copy)"
    else
        echo "pinned:   nothing yet (tools/nukkit-dev pin <build> or pin-maven <version>; read against ${NUKKIT_READ_AT})"
    fi
    echo "dir:      ${nukkit_dir}"
    if pinned; then
        local jar
        jar="$(jar_path)"
        if verified "${jar}"; then
            echo "jar:      ${jar} (verified)"
        elif [[ -f "${jar}" ]]; then
            echo "jar:      ${jar} (DIGEST MISMATCH: refused)"
        else
            echo "jar:      absent (tools/nukkit-dev fetch)"
        fi
    fi
    local home
    if home="$(find_java_home)"; then
        echo "jdk:      ${home}"
    else
        echo "jdk:      none found with javac, jni.h and ct.sym (set JAVA_HOME)"
    fi
}

cmd_fetch() {
    require_pin
    local jar
    jar="$(jar_path)"
    if verified "${jar}"; then
        log "already fetched and verified: ${jar}"
        printf '%s\n' "${jar}"
        return 0
    fi
    [[ -e "${jar}" ]] && die "${jar} exists and is not the pinned jar (sha256 $(sha256_of "${jar}")); \
remove it by hand after looking at what it is"
    mkdir -p "${nukkit_dir}/jars"
    local quarantined="${nukkit_dir}/quarantine/nukkit-${NUKKIT_BUILD}.jar"
    local part="${jar}.part"
    rm -f "${part}"
    if [[ -f "${quarantined}" ]] && [[ "$(sha256_of "${quarantined}")" == "${NUKKIT_SHA256}" ]]; then
        log "using the copy 'pin' downloaded: ${quarantined}"
        cp "${quarantined}" "${part}"
    else
        log "downloading build ${NUKKIT_BUILD}: ${NUKKIT_URL}"
        local code
        if ! code="$(download "${NUKKIT_URL}" "${part}")"; then
            rm -f "${part}"
            die "$(fetch_refusal "${code}"); nothing installed"
        fi
    fi
    local got
    got="$(sha256_of "${part}")"
    if [[ "${got}" != "${NUKKIT_SHA256}" ]]; then
        rm -f "${part}"
        die "build ${NUKKIT_BUILD}'s jar has sha256 ${got}, not the pinned ${NUKKIT_SHA256}: refused"
    fi
    mv "${part}" "${jar}"
    log "verified: ${jar}. Keep it: neither the CI nor the snapshot repository keeps a build for ever"
    printf '%s\n' "${jar}"
}

cmd_print_jar() {
    require_pin
    local jar
    jar="$(jar_path)"
    verified "${jar}" || die "no verified Nukkit jar at ${jar} (tools/nukkit-dev fetch)"
    printf '%s\n' "${jar}"
}

cmd_pin() {
    local build="${1:-}"
    [[ "${build}" =~ ^[0-9]+$ ]] || die "usage: tools/nukkit-dev pin <build number>"
    local meta_file
    meta_file="$(mktemp)"
    local code
    if ! code="$(download "${NUKKIT_CI_JOB}/${build}/api/json?tree=result,timestamp,artifacts%5BrelativePath%5D,actions%5BlastBuiltRevision%5BSHA1%5D%5D" "${meta_file}")"; then
        rm -f "${meta_file}"
        die "$(ci_refusal "${code}" "${build}")"
    fi
    local parsed
    parsed="$(python3 -I -c '
import json, sys
with open(sys.argv[1], encoding="utf-8") as f:
    build = json.load(f)
commits = sorted({a["lastBuiltRevision"]["SHA1"] for a in build.get("actions") or []
                  if a and a.get("lastBuiltRevision")})
jars = [a["relativePath"] for a in build.get("artifacts") or []
        if a["relativePath"].endswith(".jar")
        and not any(word in a["relativePath"].lower() for word in ("sources", "javadoc", "original"))]
print(build.get("result") or "UNKNOWN")
print(",".join(commits))
print("\n".join(jars))
' "${meta_file}")"
    rm -f "${meta_file}"
    local result commit
    result="$(sed -n 1p <<<"${parsed}")"
    commit="$(sed -n 2p <<<"${parsed}")"
    local -a jars
    mapfile -t jars < <(sed -n '3,$p' <<<"${parsed}" | sed '/^$/d')
    [[ "${result}" == "SUCCESS" ]] || die "build ${build} is ${result}, not SUCCESS: refused"
    [[ "${commit}" =~ ^[0-9a-f]{40}$ ]] || die "build ${build} names no single commit (${commit:-none})"
    [[ ${#jars[@]} -eq 1 ]] || die "build ${build} has ${#jars[@]} candidate server jars \
(${jars[*]:-none}); pin one by hand"
    mkdir -p "${nukkit_dir}/quarantine"
    local quarantined="${nukkit_dir}/quarantine/nukkit-${build}.jar"
    log "downloading build ${build}'s ${jars[0]} into quarantine (not installed)"
    if ! code="$(download "${NUKKIT_CI_JOB}/${build}/artifact/${jars[0]}" "${quarantined}.part")"; then
        rm -f "${quarantined}.part"
        die "$(ci_refusal "${code}" "${build}")"
    fi
    mv "${quarantined}.part" "${quarantined}"
    local digest
    digest="$(sha256_of "${quarantined}")"
    [[ "${commit}" == "${NUKKIT_READ_AT}" ]] || log "note: build ${build} built ${commit}, not the \
commit this binding was read against (${NUKKIT_READ_AT})"
    cat <<EOF
# Paste into tools/nukkit-dev, replacing the empty pin, then: tools/nukkit-dev fetch
# Keep ${quarantined}: the CI deletes build ${build}'s jar ${NUKKIT_CI_KEEPS} builds later.
readonly NUKKIT_BUILD="${build}"
readonly NUKKIT_COMMIT="${commit}"
readonly NUKKIT_URL="${NUKKIT_CI_JOB}/${build}/artifact/${jars[0]}"
readonly NUKKIT_SHA256="${digest}"
EOF
}

# pin-maven <version>: what `pin` does, for a snapshot version of
# cn.nukkit:nukkit in CloudburstMC's Maven snapshot repository, where its
# GitHub deploy job publishes every master push (the shaded server jar is
# the artifact with no classifier; "-dev" is the bare library). The commit
# is the build's own git.properties; the download is checked against the
# repository's .sha1 beside it, and refused unless it is a runnable Nukkit
# server (Main-Class cn.nukkit.Nukkit).
cmd_pin_maven() {
    local version="${1:-}"
    [[ "${version}" =~ ^1\.0-[0-9]{8}\.[0-9]{6}-[0-9]+$ ]] \
        || die "usage: tools/nukkit-dev pin-maven <version>, a snapshot version such as 1.0-20260919.123832-1250 (${NUKKIT_MAVEN}/maven-metadata.xml lists them)"
    local base="${NUKKIT_MAVEN}/nukkit-${version}"
    local tmp code
    tmp="$(mktemp -d)"
    if ! code="$(download "${base}.properties" "${tmp}/git.properties")"; then
        rm -rf "${tmp}"
        die "${base}.properties answered HTTP ${code}: no such snapshot"
    fi
    local commit
    commit="$(sed -n 's/^git\.commit\.id=//p' "${tmp}/git.properties" | tr -d '\r')"
    [[ "${commit}" =~ ^[0-9a-f]{40}$ ]] || { rm -rf "${tmp}"; die "snapshot ${version} names no single commit"; }
    if ! code="$(download "${base}.jar.sha1" "${tmp}/jar.sha1")"; then
        rm -rf "${tmp}"
        die "${base}.jar.sha1 answered HTTP ${code}"
    fi
    local want_sha1
    want_sha1="$(tr -d ' \r\n' <"${tmp}/jar.sha1")"
    rm -rf "${tmp}"
    [[ "${want_sha1}" =~ ^[0-9a-f]{40}$ ]] || die "${base}.jar.sha1 is not a SHA-1"

    mkdir -p "${nukkit_dir}/quarantine"
    local quarantined="${nukkit_dir}/quarantine/nukkit-${version}.jar"
    log "downloading snapshot ${version}'s server jar into quarantine (not installed)"
    if ! code="$(download "${base}.jar" "${quarantined}.part")"; then
        rm -f "${quarantined}.part"
        die "${base}.jar answered HTTP ${code}; nothing kept"
    fi
    local got_sha1
    got_sha1="$(sha1sum "${quarantined}.part" | cut -d' ' -f1)"
    if [[ "${got_sha1}" != "${want_sha1}" ]]; then
        rm -f "${quarantined}.part"
        die "the download's SHA-1 is ${got_sha1}, not the repository's ${want_sha1}: refused"
    fi
    local main
    main="$(python3 -I -c '
import sys, zipfile
with zipfile.ZipFile(sys.argv[1]) as jar:
    manifest = jar.read("META-INF/MANIFEST.MF").decode("utf-8", "replace")
print(next((line.split(":", 1)[1].strip() for line in manifest.splitlines()
            if line.startswith("Main-Class:")), ""))
' "${quarantined}.part" 2>/dev/null)" || main=""
    if [[ "${main}" != "cn.nukkit.Nukkit" ]]; then
        rm -f "${quarantined}.part"
        die "snapshot ${version}'s jar is not a runnable Nukkit server (Main-Class '${main}'): refused"
    fi
    mv "${quarantined}.part" "${quarantined}"
    local digest
    digest="$(sha256_of "${quarantined}")"
    [[ "${commit}" == "${NUKKIT_READ_AT}" ]] || log "note: snapshot ${version} built ${commit}, not the \
commit this binding was read against (${NUKKIT_READ_AT})"
    cat <<EOF
# Paste into tools/nukkit-dev, replacing the empty pin, then: tools/nukkit-dev fetch
# Keep ${quarantined}: a snapshot repository does not keep old snapshots for ever.
readonly NUKKIT_BUILD="${version}"
readonly NUKKIT_COMMIT="${commit}"
readonly NUKKIT_URL="${base}.jar"
readonly NUKKIT_SHA256="${digest}"
EOF
}

# server <dir> --plugin <jar> (--pack <root> | --no-pack) [--smoke-plugin <jar>]
#        [--seed <n>] [--workers <n>] [--port <n>] [--world <name>]
cmd_server() {
    local dir="${1:-}"
    [[ -n "${dir}" ]] || die "usage: tools/nukkit-dev server <dir> --plugin <jar> --pack <version root> [options]"
    shift
    local plugin="" smoke_plugin="" pack="" no_pack=0 seed="20260915" workers="4" port="19232" world="stratum"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --plugin) plugin="$2"; shift 2 ;;
            --smoke-plugin) smoke_plugin="$2"; shift 2 ;;
            --pack) pack="$2"; shift 2 ;;
            --no-pack) no_pack=1; shift ;;
            --seed) seed="$2"; shift 2 ;;
            --workers) workers="$2"; shift 2 ;;
            --port) port="$2"; shift 2 ;;
            --world) world="$2"; shift 2 ;;
            *) die "server: unknown option $1" ;;
        esac
    done
    [[ -f "${plugin}" ]] || die "server: --plugin must name the built Stratum plugin jar"
    if [[ ${no_pack} -eq 0 ]]; then
        [[ -d "${pack}/worldgen" ]] || die "server: --pack must be a version root (tools/fetch-vanilla's), not ${pack}"
    fi
    [[ "${seed}" =~ ^-?[0-9]+$ && "${seed}" != 0 ]] || die "server: --seed must be a non-zero integer"
    [[ "${port}" =~ ^[0-9]+$ && "${port}" != 19132 && "${port}" != 19133 ]] \
        || die "server: --port must be a number other than Bedrock's defaults"
    [[ "${workers}" =~ ^[1-9][0-9]*$ ]] || die "server: --workers must be a positive number"
    [[ "${world}" =~ ^[A-Za-z0-9_-]+$ ]] || die "server: --world must be a plain name"

    mkdir -p "${dir}/plugins/bStats"
    dir="$(cd "${dir}" && pwd)"
    local blob="${dir}/worlds/${world}/stratum-pipeline.blob"
    [[ ${no_pack} -eq 1 ]] || pack="$(cd "${pack}" && pwd -P)"
    # Nukkit's properties reader takes a value verbatim (no escapes), and the
    # value is a JSON object: a path that would need escaping in either is
    # refused rather than written broken.
    local path
    for path in "${blob}" "${pack}"; do
        [[ "${path}" != *[\"\\]* && "${path}" != *$'\n'* && "${path}" != *$'\r'* ]] \
            || die "server: ${path} holds a quote, backslash or line break, which the generator options cannot carry"
    done
    local settings="{\"blob\":\"${blob}\",\"pack\":\"${pack}\"}"
    [[ ${no_pack} -eq 0 ]] || settings="{\"blob\":\"${blob}\"}"

    # Every default that listens or talks, set; the rest as Nukkit has it.
    cat >"${dir}/server.properties" <<EOF
#Written by tools/nukkit-dev: a Stratum test server. Not hermetic unless run
#by tools/nukkit-dev smoke (see that script's NETWORK note).
motd=Stratum test server
sub-motd=not for players
server-ip=127.0.0.1
server-port=${port}
enable-query=off
enable-rcon=off
white-list=on
max-players=0
view-distance=4
level-name=${world}
level-seed=${seed}
level-type=stratum
generator-settings=${settings}
allow-nether=off
allow-the-end=off
auto-save=on
EOF
    cat >"${dir}/nukkit.yml" <<EOF
# Written by tools/nukkit-dev. Only what differs from Nukkit's own defaults.
settings:
 language: "eng"
 query-plugins: false
 async-workers: ${workers}
debug:
 level: 1
# No worlds beyond the default one, which server.properties makes Stratum's.
worlds: {}
EOF
    # Written before Nukkit's first start, which would otherwise create it
    # with metrics enabled.
    cat >"${dir}/plugins/bStats/config.yml" <<EOF
enabled: false
serverUuid: "00000000-0000-0000-0000-000000000000"
logFailedRequests: false
EOF
    # Synthetic auth caches (see NETWORK above): Nukkit falls back to them
    # when its startup fetches fail, and stops without them. They name only
    # auth.invalid (RFC 6761: never resolves); jose4j fetches the JWKS they
    # point at only when a player logs in.
    cat >"${dir}/discovery-cache.json" <<'EOF'
{"result":{"serviceEnvironments":{"auth":{"prod":{"serviceUri":"https://auth.invalid"}}}}}
EOF
    cat >"${dir}/openid-cache.json" <<'EOF'
{"issuer":"https://auth.invalid","jwks_uri":"https://auth.invalid/keys"}
EOF
    : >"${dir}/white-list.txt"
    # Copies, not links: the default directory is on a disk that has none.
    cp "${plugin}" "${dir}/plugins/stratum-nukkit.jar"
    if [[ -n "${smoke_plugin}" ]]; then
        cp "${smoke_plugin}" "${dir}/plugins/stratum-nukkit-smoke.jar"
    else
        rm -f "${dir}/plugins/stratum-nukkit-smoke.jar"
    fi
    if [[ "${server_note}" -eq 1 ]]; then
        log "note: ${dir} is configured to keep to itself, but Nukkit fetches Microsoft's auth \
discovery data on every start whatever its configuration: started outside a network namespace, it \
reaches those hosts (tools/nukkit-dev smoke runs it inside one)"
    fi
    printf '%s\n' "${dir}"
}

# One server run, headless and in its own network namespace. Exit status is
# the server's; stdout and stderr go to console-<mode>.log.
run_server() { # dir java jar library mode radius limit
    local dir="$1" java="$2" jar="$3" library="$4" mode="$5" radius="$6" limit="$7"
    local fifo_dir
    fifo_dir="$(mktemp -d)"
    mkfifo "${fifo_dir}/stdin"
    # A console that never reaches end-of-file: Nukkit's reads its standard
    # input for commands, and the plugin stops the server itself.
    sleep infinity >"${fifo_dir}/stdin" &
    local holder=$!
    local status=0
    # JDK 24+ warns when a library is loaded without it; JDK 11 refuses it.
    local -a native_access=()
    if "${java}" --enable-native-access=ALL-UNNAMED -version >/dev/null 2>&1; then
        native_access=(--enable-native-access=ALL-UNNAMED)
    fi
    (
        cd "${dir}"
        exec timeout --kill-after=30 "${limit}" unshare --user --map-root-user --net \
            sh -c 'ip link set lo up && exec "$@"' sh \
            "${java}" -Xmx2G "${native_access[@]}" \
            "-Dstratum.nukkit.library=${library}" \
            "-Dstratum.smoke.mode=${mode}" \
            "-Dstratum.smoke.radius=${radius}" \
            "-Dstratum.smoke.report=${dir}/report-${mode}.properties" \
            -jar "${jar}" --language eng
    ) <"${fifo_dir}/stdin" >"${dir}/console-${mode}.log" 2>&1 || status=$?
    kill "${holder}" 2>/dev/null || true
    wait "${holder}" 2>/dev/null || true
    rm -rf "${fifo_dir}"
    # Nukkit rolls logs/server.log over at the next start: keep this run's.
    [[ -f "${dir}/logs/server.log" ]] && cp "${dir}/logs/server.log" "${dir}/server-${mode}.log"
    [[ -f "${dir}/logs/leveldb/latest.log" ]] && cp "${dir}/logs/leveldb/latest.log" "${dir}/leveldb-${mode}.log"
    return "${status}"
}

prop() { # file key: a value java.util.Properties stored
    sed -n "s/^$2=//p" "$1" | head -1 | sed 's/\\:/:/g; s/\\=/=/g; s/\\ / /g'
}

# Exit status 0 when property $2 of $1 is a whole number at least $3.
at_least() { # file key minimum
    local value
    value="$(prop "$1" "$2")"
    [[ "${value}" =~ ^[0-9]+$ ]] && (( value >= $3 ))
}

# Reads one Nukkit log (console or logs/server.log) as entries — a line with
# a timestamp and level, and the lines under it — and prints a line per
# problem, then three tallies: "auth-discovery N", "auth-openid N",
# "refusals N". A problem is any ERROR or FATAL entry, any stack trace, and
# any line naming an Exception or Throwable, except:
#   - each of Nukkit's two startup auth fetches failing (ERROR "Failed to
#     fetch <url>" with an UnknownHostException trace for that url's host,
#     and nothing else under it), at most once each;
#   - with refusals=<world>, the plugin's own "REFUSED stratum: world
#     '<world>'" and "STOPPING the server" lines, nothing under them.
scan_log() { # file [refused-world]
    sed 's/\x1b\[[0-9;]*m//g' "$1" | awk -v discovery_url="${auth_discovery_url}" \
        -v openid_url="${auth_openid_url}" -v refused_world="${2:-}" '
function host_of(url) { sub(/^https:\/\//, "", url); sub(/\/.*$/, "", url); return url }
function problem(n, text) { print "line " n ": " text; problems++ }
function finish(   i, msg, url, ok, kind) {
    if (start == 0) return
    msg = message
    ok = 0
    kind = ""
    if (level == "ERROR" && (msg == "Failed to fetch " discovery_url || msg == "Failed to fetch " openid_url)) {
        url = substr(msg, length("Failed to fetch ") + 1)
        kind = (url == discovery_url) ? "auth-discovery" : "auth-openid"
        ok = (count > 1 && (cont[1] == ("java.net.UnknownHostException: " host_of(url)) \
              || index(cont[1], "java.net.UnknownHostException: " host_of(url) ": ") == 1))
        for (i = 2; ok && i <= count; i++) {
            if (cont[i] !~ /^[ \t]+at / && cont[i] !~ /^[ \t]*\.\.\. [0-9]+ more/) ok = 0
        }
        if (ok && ++seen[kind] > 1) ok = 0
    } else if (refused_world != "" && level == "ERROR" && count == 0 \
               && (index(msg, "[Stratum] REFUSED stratum: world '\''" refused_world "'\''") == 1 \
                   || index(msg, "[Stratum] STOPPING the server before Nukkit loads") == 1)) {
        ok = 1
        kind = "refusals"
    }
    if (ok) {
        tally[kind]++
    } else {
        if (level == "ERROR" || level == "FATAL") problem(start, level " " msg)
        else if (msg ~ /Exception|Throwable/) problem(start, msg)
        for (i = 1; i <= count; i++) {
            if (cont[i] ~ /Exception|Throwable|^[ \t]+at [[:alnum:]_.$]+\(/) {
                problem(start + i, cont[i])
                break
            }
        }
    }
    start = 0
}
{
    # logs/server.log: "2026-10-15 04:40:00.123 [main] ERROR - message";
    # the console: "04:40:00 [ERROR] message" (the log4j2.xml in the jar).
    header = 0
    if (match($0, /^[0-9]+-[0-9][0-9]-[0-9][0-9] [0-9:.]+ \[[^]]*\] (TRACE|DEBUG|INFO|WARN|ERROR|FATAL) +- /)) {
        header = 1
    } else if (match($0, /^[0-9][0-9]:[0-9][0-9]:[0-9][0-9] \[(TRACE|DEBUG|INFO|WARN|ERROR|FATAL) *\] /)) {
        header = 1
    }
    if (header) {
        line = substr($0, 1, RLENGTH)
        rest = substr($0, RLENGTH + 1)
        match(line, /(TRACE|DEBUG|INFO|WARN|ERROR|FATAL)[] -]*$/)
        lvl = substr(line, RSTART)
        sub(/[] -]*$/, "", lvl)
        finish()
        start = NR
        level = lvl
        message = rest
        sub(/\r$/, "", message)
        count = 0
        delete cont
    } else if (start != 0) {
        cont[++count] = $0
    } else if ($0 ~ /Exception|Throwable|^[ \t]+at [[:alnum:]_.$]+\(/) {
        problem(NR, $0)
    }
}
END {
    finish()
    print "auth-discovery " (tally["auth-discovery"] + 0)
    print "auth-openid " (tally["auth-openid"] + 0)
    print "refusals " (tally["refusals"] + 0)
}'
}

# Checks one run's logs, adding to the caller's `failures`, and leaves the
# server log's tallies in `log_tallies` ("<discovery> <openid> <refusals>").
# Not run in a subshell, so that `failures` keeps what it adds.
check_logs() { # dir mode [refused-world]
    local dir="$1" mode="$2" refused="${3:-}" logfile scanned tallies="0 0 0"
    for logfile in "${dir}/server-${mode}.log" "${dir}/console-${mode}.log"; do
        if [[ ! -f "${logfile}" ]]; then
            failures+=("$(basename "${logfile}") is missing")
            continue
        fi
        scanned="$(scan_log "${logfile}" "${refused}")"
        grep -v -E '^(auth-discovery|auth-openid|refusals) [0-9]+$' <<<"${scanned}" >"${logfile}.problems" || true
        if [[ -s "${logfile}.problems" ]]; then
            failures+=("$(basename "${logfile}"): $(wc -l <"${logfile}.problems") problem(s), first: $(head -1 "${logfile}.problems")")
        else
            rm -f "${logfile}.problems"
        fi
        if [[ "${logfile}" == */server-* ]]; then
            tallies="$(sed -n 's/^auth-discovery //p; s/^auth-openid //p; s/^refusals //p' <<<"${scanned}" | paste -sd' ')"
        fi
    done
    # Any block state Nukkit's LevelDB layer could not find: its own silent
    # info_update substitution.
    logfile="${dir}/leveldb-${mode}.log"
    if [[ -f "${logfile}" ]] && grep -n 'Can not find' "${logfile}" >"${logfile}.problems"; then
        failures+=("$(basename "${logfile}"): Nukkit substituted block states: $(head -1 "${logfile}.problems")")
    else
        rm -f "${logfile}.problems"
    fi
    log_tallies="${tallies}"
}

# Empties and remakes a smoke server directory — only one smoke made, or an
# empty one.
fresh_smoke_dir() { # dir
    local dir="$1"
    case "${dir%/}" in
        "" | "/" | "${HOME}" | "${HOME%/}" | "${nukkit_dir%/}")
            die "smoke: refusing to use ${dir:-an empty path} as the smoke server directory" ;;
    esac
    if [[ -e "${dir}" || -L "${dir}" ]]; then
        [[ -d "${dir}" && ! -L "${dir}" ]] || die "smoke: ${dir} exists and is not a directory: refused"
        if [[ -n "$(ls -A -- "${dir}")" && ! -f "${dir}/${smoke_marker}" ]]; then
            die "smoke: refusing to empty ${dir}: it is not empty and holds no ${smoke_marker}, so \
smoke did not make it. Point --dir (or STRATUM_NUKKIT_SERVER_DIR) at a new or empty directory"
        fi
        rm -rf -- "${dir}"
    fi
    mkdir -p -- "${dir}"
    printf '%s\n' "A tools/nukkit-dev smoke server: every smoke run empties and rebuilds this directory." \
        >"${dir}/${smoke_marker}"
}

cmd_smoke() {
    local jar="" plugin="" smoke_plugin="" library="" pack="" java="java"
    local dir="${STRATUM_NUKKIT_SERVER_DIR:-${nukkit_dir}/servers/smoke}" radius=4 workers=4 seed=20260915
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --jar) jar="$2"; shift 2 ;;
            --plugin) plugin="$2"; shift 2 ;;
            --smoke-plugin) smoke_plugin="$2"; shift 2 ;;
            --library) library="$2"; shift 2 ;;
            --pack) pack="$2"; shift 2 ;;
            --java) java="$2"; shift 2 ;;
            --dir) dir="$2"; shift 2 ;;
            --radius) radius="$2"; shift 2 ;;
            --workers) workers="$2"; shift 2 ;;
            --seed) seed="$2"; shift 2 ;;
            *) die "smoke: unknown option $1" ;;
        esac
    done
    if [[ ! -d "${pack}/worldgen" ]]; then
        echo "SKIP: no worldgen fixtures under ${pack}; run tools/fetch-vanilla first"
        exit 77
    fi
    require_pin
    [[ -n "${jar}" ]] || jar="$(jar_path)"
    verified "${jar}" || die "smoke: ${jar} is not the pinned Nukkit jar (sha256 \
$( [[ -f "${jar}" ]] && sha256_of "${jar}" || echo absent)): refused"
    [[ -f "${plugin}" && -f "${smoke_plugin}" && -f "${library}" ]] \
        || die "smoke: --plugin, --smoke-plugin and --library must name the built jars and library"
    [[ "${radius}" =~ ^[0-9]+$ ]] || die "smoke: --radius must be a whole number"
    unshare --user --map-root-user --net true 2>/dev/null \
        || die "smoke: unshare cannot make a network namespace here, and the smoke server runs in one"
    command -v ip >/dev/null || die "smoke: needs iproute2's ip, to raise loopback inside the namespace"
    library="$(cd "$(dirname "${library}")" && pwd)/$(basename "${library}")"

    fresh_smoke_dir "${dir}"
    dir="$(cd "${dir}" && pwd)"
    log "smoke server in ${dir}"

    local failures=()
    local status

    # Run 0: a Stratum world that must be refused (no frozen pipeline, no
    # pack to write one from). The plugin refuses it at STARTUP, by name, and
    # stops the server, status 1, before Nukkit creates anything for it.
    server_note=0
    cmd_server "${dir}" --plugin "${plugin}" --smoke-plugin "${smoke_plugin}" --no-pack \
        --world refused --seed "${seed}" --workers "${workers}" >/dev/null
    log "run 0: a world with no frozen pipeline is refused before Nukkit creates it"
    status=0
    run_server "${dir}" "${java}" "${jar}" "${library}" refuse "${radius}" 300 || status=$?
    [[ ${status} -eq 1 ]] || failures+=("run 0 exited with status ${status}, not the refusal's 1")
    [[ ! -e "${dir}/worlds/refused" ]] || failures+=("run 0 left worlds/refused behind")
    local refuse_tallies generate_tallies readback_tallies log_tallies
    check_logs "${dir}" refuse refused
    refuse_tallies="${log_tallies}"
    [[ "$(cut -d' ' -f3 <<<"${refuse_tallies}")" == 2 ]] \
        || failures+=("run 0's server log holds $(cut -d' ' -f3 <<<"${refuse_tallies}") of the 2 refusal lines (REFUSED, STOPPING)")

    cmd_server "${dir}" --plugin "${plugin}" --smoke-plugin "${smoke_plugin}" --pack "${pack}" \
        --seed "${seed}" --workers "${workers}" >/dev/null
    log "run 1: create the world, generate the spawn area, compare it in memory, stop"
    status=0
    run_server "${dir}" "${java}" "${jar}" "${library}" generate "${radius}" 1200 || status=$?
    [[ ${status} -eq 0 ]] || failures+=("run 1 exited with status ${status}")
    log "run 2: load the world, read the area back from disk, compare, stop"
    status=0
    run_server "${dir}" "${java}" "${jar}" "${library}" readback "${radius}" 1200 || status=$?
    [[ ${status} -eq 0 ]] || failures+=("run 2 exited with status ${status}")
    check_logs "${dir}" generate
    generate_tallies="${log_tallies}"
    check_logs "${dir}" readback
    readback_tallies="${log_tallies}"

    local generate="${dir}/report-generate.properties" readback="${dir}/report-readback.properties"
    # Nukkit's own main exits 0 even when its startup threw, so a status of 0
    # proves nothing: the reports and the logs are the evidence.
    [[ -f "${generate}" ]] || failures+=("run 1 wrote no report")
    [[ -f "${readback}" ]] || failures+=("run 2 wrote no report")
    local offset_defect=0
    if [[ -f "${generate}" && -f "${readback}" ]]; then
        local area
        area="$(prop "${generate}" area_chunks)"
        [[ "$(prop "${generate}" outcome)" == ok ]] || failures+=("run 1: $(prop "${generate}" outcome)")
        [[ "$(prop "${readback}" outcome)" == ok ]] || failures+=("run 2: $(prop "${readback}" outcome)")
        [[ "$(prop "${readback}" level_dat_generator)" == stratum ]] \
            || failures+=("level.dat names generator '$(prop "${readback}" level_dat_generator)', not stratum")
        [[ "${area}" =~ ^[1-9][0-9]*$ ]] || failures+=("run 1 reports no area (area_chunks '${area}')")
        at_least "${generate}" chunks_generated_by_stratum "${area:-1}" \
            || failures+=("Stratum filled $(prop "${generate}" chunks_generated_by_stratum) chunks of ${area}")
        [[ "$(prop "${readback}" chunks_missing_on_disk)" == 0 ]] \
            || failures+=("$(prop "${readback}" chunks_missing_on_disk) of ${area} chunks are not on disk")
        [[ "$(prop "${readback}" chunks_generated_during_readback)" == 0 ]] \
            || failures+=("run 2 generated chunks it should have read")
        local where
        for where in memory disk; do
            local report="${generate}"
            [[ "${where}" == disk ]] && report="${readback}"
            [[ "$(prop "${report}" "chunks_compared_${where}")" == "${area}" ]] \
                || failures+=("${where}: compared $(prop "${report}" "chunks_compared_${where}") of ${area} chunks")
            [[ "$(prop "${report}" "block_mismatches_${where}")" == 0 ]] \
                || failures+=("${where}: $(prop "${report}" "block_mismatches_${where}") blocks differ from the fill")
        done
        [[ "$(prop "${generate}" biome_mismatches_memory)" == 0 ]] \
            || failures+=("memory: $(prop "${generate}" biome_mismatches_memory) biomes differ from the fill")
        local disk_biomes offset_biomes
        disk_biomes="$(prop "${readback}" biome_mismatches_disk)"
        offset_biomes="$(prop "${readback}" biome_mismatches_disk_explained_by_section_offset)"
        if [[ "${disk_biomes}" != 0 && "${disk_biomes}" != "${offset_biomes}" ]]; then
            failures+=("disk: ${disk_biomes} biomes differ from the fill, $((disk_biomes - offset_biomes)) not by Nukkit's section offset")
        elif [[ "${disk_biomes}" != 0 ]]; then
            offset_defect=1
        fi
    fi

    local summary="${dir}/smoke-summary.txt"
    {
        echo "Stratum Nukkit smoke, $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "nukkit:   build ${NUKKIT_BUILD} (${NUKKIT_COMMIT:-commit unrecorded}), sha256 ${NUKKIT_SHA256}"
        echo "java:     $("${java}" -version 2>&1 | head -1)"
        echo "server:   ${dir}"
        echo "network:  a namespace holding loopback alone; Nukkit's startup auth fetches failed as expected: discovery/openid $(cut -d' ' -f1-2 <<<"${refuse_tallies}" | tr ' ' /), $(cut -d' ' -f1-2 <<<"${generate_tallies}" | tr ' ' /), $(cut -d' ' -f1-2 <<<"${readback_tallies}" | tr ' ' /) (runs 0, 1, 2)"
        echo "refusal:  run 0 stopped at STARTUP with $(cut -d' ' -f3 <<<"${refuse_tallies}") refusal line(s) and no worlds/refused"
        if [[ -f "${generate}" ]]; then
            echo "world:    $(prop "${generate}" level), seed $(prop "${generate}" seed), $(prop "${generate}" area)"
            echo "spawn:    $(prop "${generate}" chunks_generated_by_stratum) chunks in $(prop "${generate}" spawn_generation_ms) ms on $(prop "${generate}" generation_threads) generation threads (async-workers $(prop "${generate}" async_workers)): $(prop "${generate}" generation_thread_names)"
            echo "census:   $(prop "${generate}" census_emittable_states) emittable states, all resolved: $(prop "${generate}" census_emittable_resolved)"
            echo "          all Java states: $(prop "${generate}" census_all_java_states) (Nukkit palette $(prop "${generate}" nukkit_palette_version), engine table $(prop "${generate}" engine_table_version))"
            echo "biomes:   $(prop "${generate}" census_biomes); unknown to Nukkit: $(prop "${generate}" census_biomes_unknown_to_nukkit)"
            echo "memory:   $(prop "${generate}" chunks_compared_memory) chunks, $(prop "${generate}" block_mismatches_memory) block and $(prop "${generate}" biome_mismatches_memory) biome mismatches"
            echo "fluids:   $(prop "${generate}" fluid_updates_scheduled) liquid updates scheduled as chunks populated"
        fi
        if [[ -f "${readback}" ]]; then
            echo "disk:     $(prop "${readback}" chunks_compared_disk) chunks, $(prop "${readback}" block_mismatches_disk) block and $(prop "${readback}" biome_mismatches_disk) biome mismatches ($(prop "${readback}" biome_mismatches_disk_explained_by_section_offset) of them Nukkit's LevelDB section offset); level.dat generator '$(prop "${readback}" level_dat_generator)'"
        fi
        if [[ ${#failures[@]} -ne 0 ]]; then
            printf 'FAIL: %s\n' "${failures[@]}"
        elif [[ ${offset_defect} -eq 1 ]]; then
            echo "PASS, with Nukkit's own limitation: every check Stratum owns passed, and every biome"
            echo "          Nukkit read back from disk is the one generated 64 blocks higher (the top four"
            echo "          sections: the bottom one's) — Nukkit's Data3dSerializer passes array indices to"
            echo "          getBiomeStorage, which takes a section y; NetworkChunkSerializer sends clients"
            echo "          the same. A limitation of Nukkit itself, recorded, not Stratum's to fix"
            echo "          (owner, 2026-10-29; SPEC §11, M5-Nukkit)."
        else
            echo "PASS"
        fi
    } | tee "${summary}"
    if [[ ${#failures[@]} -ne 0 ]]; then
        return 1
    fi
    return 0
}

case "${1:-}" in
    "" | status) cmd_status ;;
    fetch) cmd_fetch ;;
    --print-jar) cmd_print_jar ;;
    --print-java-home) find_java_home || die "no JDK with javac, include/jni.h and lib/ct.sym found; set JAVA_HOME" ;;
    pin) shift; cmd_pin "$@" ;;
    pin-maven) shift; cmd_pin_maven "$@" ;;
    server) shift; cmd_server "$@" ;;
    smoke) shift; cmd_smoke "$@" ;;
    scan-log) shift; [[ -f "${1:-}" ]] || die "usage: tools/nukkit-dev scan-log <log> [refused world]"
        scan_log "$@" ;;
    *) sed -n '2,30p' "${BASH_SOURCE[0]}" >&2; exit 2 ;;
esac
