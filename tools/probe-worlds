def density(*pairs):
    """Corpora written by density-probe.sh: probes/<corpus>/{manifest,spec}.json."""
    return [{'dir': corpus, 'seed': seed, 'density': True} for corpus, seed in pairs]


def own(directory, files, record=None):
    """A generator with a layout of its own: files under probes/<dir>."""
    out = {'dir': directory, 'files': list(files)}
    if record:
        out['record'] = record
    return [out]


def unit(name, shard, argv, outputs):
    return {'name': name, 'shard': shard, 'argv': [ANALYSIS + argv[0]] + list(argv[1:]),
