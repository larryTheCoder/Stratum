def option(argv, flag, default):
    return argv[argv.index(flag) + 1] if flag in argv else default


def golden(name, shard, *options):
    """A tools/fetch-vanilla --generate-regions run, and the region files it
    collects: regions/seed-<seed>/<dimension>/r.<x>.<z>.mca, read off its own
    arguments with fetch-vanilla's defaults."""
    argv = [FETCH, '--generate-regions', *options]
    seeds = option(argv, '--seeds', ','.join(GOLDEN_SEEDS)).split(',')
    dimensions = option(argv, '--dimensions', 'overworld,nether,end').split(',')
    regions = option(argv, '--regions', '0,0').split()
    files = [f'seed-{seed}/{dimension}/r.{region.replace(",", ".")}.mca'
             for seed in seeds for dimension in dimensions for region in regions]
    return unit(name, shard, argv, [{'root': REGIONS, 'file': f} for f in files])


