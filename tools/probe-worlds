def root_of(out):
    """The tree an output lives in: probes/ unless it says otherwise."""
    return out.get('root', PROBES)


def path_of(out):
    """An output's path under its tree: a corpus directory, or one golden file."""
    return out['file'] if 'file' in out else out['dir']


def shard_root(shard):
    """The one tree a shard writes into, which is what CI caches it as."""
    return root_of(next(out for u in UNITS if u['shard'] == shard for out in u['outputs']))


def die(message, code=1):
    print(f'probe-worlds: {message}', file=sys.stderr)
    sys.exit(code)


def select(shard, only):
    if shard is not None and shard not in SHARDS:
        die(f'unknown shard {shard!r}; the shards are {", ".join(SHARDS)}', 2)
    chosen = [u for u in UNITS
              if (shard is None or u['shard'] == shard)
              and (only is None or fnmatch.fnmatch(u['name'], only)
                   or fnmatch.fnmatch(os.path.basename(u['argv'][0]), only))]
    if not chosen:
        die(f'no unit matches --only {only!r}', 2)
    return chosen


def outputs(units):
    return [out for u in units for out in u['outputs']]


# --- verify -----------------------------------------------------------------

STATUS_TAG = re.compile(rb'\x08\x00\x06Status(..)', re.S)


def unfinished_chunks(data):
    """What keeps a region file from being a golden: a chunk missing, one the
    container cannot hand back, or one short of full status. Reads the
    container (a 4 KiB table of 1024 sector locations, each chunk a length,
    a compression byte and the payload) and each chunk's root `Status`
    string, and nothing else; the cases decode the rest."""
    if len(data) < 8192:
        return ['shorter than its 8 KiB header']
    missing, broken, statuses = 0, [], {}
    for index in range(1024):
        location = int.from_bytes(data[index * 4:index * 4 + 4], 'big')
        if location == 0:
            missing += 1
            continue
        start = (location >> 8) * 4096
        length = int.from_bytes(data[start:start + 4], 'big')
        kind = data[start + 4] if start + 4 < len(data) else None
        try:
            if kind == 1:
                payload = zlib.decompress(data[start + 5:start + 4 + length], 47)
            elif kind == 2:
                payload = zlib.decompress(data[start + 5:start + 4 + length])
            elif kind == 3:
                payload = data[start + 5:start + 4 + length]
            else:
                raise ValueError(f'compression {kind!r}')
        except (ValueError, zlib.error) as error:
            broken.append(f'chunk {index % 32},{index // 32}: {error}')
            continue
        found = STATUS_TAG.search(payload)
        size = int.from_bytes(found.group(1), 'big') if found else 0
        status = payload[found.end():found.end() + size].decode('utf-8', 'replace') if found else None
        if status != 'minecraft:full':
            statuses.setdefault(status, []).append(f'{index % 32},{index // 32}')
    problems = [f'{missing} of 1024 chunks missing'] if missing else []
    problems += broken[:3] + ([f'... {len(broken) - 3} more'] if len(broken) > 3 else [])
    problems += [f'{len(chunks)} chunk(s) at status {status!r} (first {chunks[0]}), not minecraft:full'
                 for status, chunks in sorted(statuses.items(), key=lambda item: str(item[0]))]
    return problems


def problems_in(units, version_dir):
    problems = []

    def present(path):
        if not path.is_file() or path.stat().st_size == 0:
            problems.append(f'{path.relative_to(version_dir)}: missing or empty')
            return False
        return True

    def record(path, seed, frozen):
        if not present(path):
            return None
        try:
            data = json.loads(path.read_text())
        except ValueError as error:
            problems.append(f'{path.relative_to(version_dir)}: not JSON ({error})')
            return None
        if not isinstance(data, dict):
            problems.append(f'{path.relative_to(version_dir)}: not a JSON object')
            return None
        if data.get('seed') != seed:
            problems.append(f'{path.relative_to(version_dir)}: seed {data.get("seed")!r}, '
                            f'expected {seed}')
        if frozen and data.get('ticks_frozen') is not True:
            problems.append(f'{path.relative_to(version_dir)}: ticks_frozen is '
                            f'{data.get("ticks_frozen")!r}; the world was not frozen')
        return data

    probes = version_dir / PROBES
    for out in outputs(units):
        if root_of(out) == REGIONS:
            path = version_dir / REGIONS / out['file']
            if present(path):
                problems += [f'{REGIONS}/{out["file"]}: {problem}'
                             for problem in unfinished_chunks(path.read_bytes())]
            continue
        root = probes / out['dir']
        if out.get('density'):
            manifest = record(root / 'manifest.json', out['seed'], True)
            if manifest is None or not present(root / 'spec.json'):
                continue
            try:
                entries = [entry['name'] for entry in json.loads((root / 'spec.json').read_text())]
            except (ValueError, TypeError, KeyError) as error:
                problems.append(f'{out["dir"]}/spec.json: unreadable ({error!r})')
                continue
            if not entries:
                problems.append(f'{out["dir"]}/spec.json names no entries')
            for name in entries:
                present(root / name / manifest.get('region', 'r.0.0.mca'))
            continue
        spec = out.get('record')
        if spec:
            data = record(root / spec['file'], spec['seed'], spec.get('frozen', False))
            if data is not None and 'variants' in spec and (
                    data.get('version') != VERSION
                    or len(data.get('variants') or []) != spec['variants']):
                problems.append(f'{out["dir"]}/{spec["file"]}: expected version {VERSION} '
                                f'and {spec["variants"]} variants')
        for name in out['files']:
            present(root / name)
    return problems


def verify(units, fixtures):
    version_dir = fixtures / VERSION
    problems = problems_in(units, version_dir)
    count = len(outputs(units))
    goldens = sum(root_of(out) == REGIONS for out in outputs(units))
    if problems:
        print(f'{len(problems)} problem(s) across {count} output(s) under {version_dir}:',
              file=sys.stderr)
        print('\n'.join('  ' + problem for problem in problems), file=sys.stderr)
        print('regenerate with: tools/probe-worlds generate --accept-eula', file=sys.stderr)
        return 1
    print(f'all {count} output(s) of {len(units)} unit(s) present: {count - goldens} probe '
          'corpora, each from the seed its cases expect, every density probe frozen; '
          f'{goldens} golden region(s), every chunk at full status')
    return 0


# --- generate ---------------------------------------------------------------

def places(out, version_dir):
    """Where an output lives, and where `generate` keeps its previous copy."""
    root = root_of(out)
    return version_dir / root / path_of(out), version_dir / (root + PREVIOUS) / path_of(out)


def remove(path):
    if path.is_dir() and not path.is_symlink():
        shutil.rmtree(path, ignore_errors=True)
    elif path.exists() or path.is_symlink():
        path.unlink()


def set_aside(u, version_dir):
    """Move a unit's outputs out of their tree before its generator runs.

    A copy already set aside is one an interrupted run left: the last
    complete one, so it stays and what is in the tree (possibly half
    written) goes."""
    for out in u['outputs']:
        current, kept = places(out, version_dir)
        if kept.exists():
            remove(current)
        elif current.exists():
            kept.parent.mkdir(parents=True, exist_ok=True)
            current.rename(kept)


def put_back(u, version_dir):
    """After a failed generator: drop what it wrote, restore what was there."""
    for out in u['outputs']:
        current, kept = places(out, version_dir)
        remove(current)
        if kept.exists():
            current.parent.mkdir(parents=True, exist_ok=True)
            kept.rename(current)


def drop_previous(u, version_dir):
    """After a generator that succeeded: its previous outputs go."""
    for out in u['outputs']:
        remove(places(out, version_dir)[1])


def prune(root):
    """Remove root's empty directories, root included."""
    if root.is_dir():
        for path in sorted(root.rglob('*'), key=lambda p: len(p.parts), reverse=True):
            if path.is_dir() and not any(path.iterdir()):
                path.rmdir()
        if not any(root.iterdir()):
            root.rmdir()


def generate(units):
    for tool in ('java', 'python3'):
        if shutil.which(tool) is None:
            die(f'{tool} is needed')
    if any(u['name'] in ('inline-noise', 'end-islands') for u in units) and not shutil.which('jq'):
        die('jq is needed (inline-noise, end-islands)')
    if any(u['argv'][0] == FETCH for u in units):
        for tool in ('curl', 'jq', 'unzip'):
            if shutil.which(tool) is None:
                die(f'{tool} is needed ({FETCH}, for the region goldens)')
    fixture_root = REPO / '.fixtures' / VERSION
    if not any(fixture_root.glob('server*.jar')) and not any(fixture_root.glob('*/server*.jar')):
        die(f'no server jar under {fixture_root}; run tools/fetch-vanilla first')
    if not ((fixture_root / 'worldgen/noise_settings/overworld.json').is_file()
            and (fixture_root / 'worldgen/biome').is_dir()):
        die(f'no extracted worldgen under {fixture_root}; run tools/fetch-vanilla first')

    # Every generator writes under <repo>/.fixtures, which is where verify looks.
    env = {k: v for k, v in os.environ.items() if k not in ('STRATUM_FIXTURES_DIR', 'PROBE_OUT')}
    in_actions = os.environ.get('GITHUB_ACTIONS') == 'true'
    rows, failed = [], []
    for u in units:
        set_aside(u, fixture_root)
        command = u['argv'] + ['--accept-eula']
        print(f'{"::group::" if in_actions else "==> "}{u["name"]}: {" ".join(command)}',
              file=sys.stderr, flush=True)
        started = time.monotonic()
        try:
            code = subprocess.call(command, cwd=REPO, env=env)
        except BaseException:
            put_back(u, fixture_root)
            raise
        seconds = round(time.monotonic() - started)
        if in_actions:
            print('::endgroup::', file=sys.stderr, flush=True)
        rows.append((u['name'], 'ok' if code == 0 else f'exit {code}', seconds))
        if code != 0:
            put_back(u, fixture_root)
            failed.append(u['name'])
            print(f'{"::error title=probe world " + u["name"] + "::" if in_actions else "error: "}'
                  f'{" ".join(command)} exited {code} after {seconds}s; its outputs are as they '
                  'were before it ran', file=sys.stderr, flush=True)
        else:
            drop_previous(u, fixture_root)
            print(f'==> {u["name"]}: done in {seconds}s', file=sys.stderr, flush=True)
        for root in {root_of(out) for out in u['outputs']}:
            prune(fixture_root / (root + PREVIOUS))

    summary = os.environ.get('GITHUB_STEP_SUMMARY')
    if summary:
        with open(summary, 'a', encoding='utf-8') as out:
            out.write('| unit | result | seconds |\n|---|---|---|\n')
            out.writelines(f'| {name} | {result} | {seconds} |\n' for name, result, seconds in rows)
    if failed:
        die(f'{len(failed)} of {len(units)} unit(s) failed: {", ".join(failed)}')
    return verify(units, REPO / '.fixtures')


# --- cache keys ---------------------------------------------------------------

def scripts_of(units):
    """Each unit's generator plus every tools/analysis/*.sh it runs, transitively.

    A script counts as run when a line that is not a comment names it; a
    script that is only mentioned in prose is not an input."""
    found, queue = set(), [u['argv'][0] for u in units]
    while queue:
        path = queue.pop()
        if path in found:
            continue
        found.add(path)
        try:
            lines = (REPO / path).read_text(encoding='utf-8').splitlines()
        except OSError as error:
            die(f'cannot read {path}: {error}')
        for line in lines:
            if not line.lstrip().startswith('#'):
                queue.extend(re.findall(r'tools/analysis/[A-Za-z0-9_.-]+\.sh', line))
    return sorted(found)


def key(shard):
    epoch, java = os.environ.get('PROBE_CACHE_EPOCH'), os.environ.get('PROBE_JAVA')
    if not epoch or not java:
        die('PROBE_CACHE_EPOCH and PROBE_JAVA must be set (ci.yml sets both)')
    pinned = os.environ.get('MINECRAFT_VERSION')
    if pinned and pinned != VERSION:
        die(f'MINECRAFT_VERSION is {pinned}, but this table is for {VERSION}')
    units = select(shard, None)
    digest = hashlib.sha256(f'format {FORMAT}\nversion {VERSION}\n'.encode())
    for u in units:
        digest.update(json.dumps(u, sort_keys=True).encode() + b'\n')
    for path in scripts_of(units):
        digest.update(path.encode() + b'\0' + (REPO / path).read_bytes() + b'\0')
    return f'probe-worlds-e{epoch}-{VERSION}-jdk{java}-{shard}-{digest.hexdigest()[:32]}'


# --- lint -------------------------------------------------------------------

def lint_goldens():
    """The golden units against tools/fetch-vanilla: its seeds, the options
    a golden may pass, and the files its arguments make it collect."""
    problems = []
    try:
        text = (REPO / FETCH).read_text(encoding='utf-8')
    except OSError as error:
        return [f'cannot read {FETCH}: {error}']
    found = re.search(r'^readonly DEFAULT_SEEDS="([^"]*)"', text, re.M)
    if not found or tuple(found.group(1).split(',')) != GOLDEN_SEEDS:
        problems.append(f'GOLDEN_SEEDS is {",".join(GOLDEN_SEEDS)}, but {FETCH}\'s DEFAULT_SEEDS is '
                        f'{found.group(1) if found else "missing"}')
    for u in UNITS:
        golden_outputs = [out for out in u['outputs'] if root_of(out) == REGIONS]
        if u['argv'][0] != FETCH:
            if golden_outputs:
                problems.append(f'{u["name"]}: only {FETCH} writes {REGIONS}/')
            continue
        if len(golden_outputs) != len(u['outputs']) or not golden_outputs:
            problems.append(f'{u["name"]}: {FETCH} writes {REGIONS}/ and nothing else')
        argv = u['argv'][1:]
        index = 0
        while index < len(argv):
            flag = argv[index]
            if flag not in GOLDEN_OPTIONS:
                problems.append(f'{u["name"]}: {FETCH} {flag} is not one a golden may pass '
                                f'({", ".join(GOLDEN_OPTIONS)}); the cases score frozen, '
                                'terrain-only, structure-free regions where they look for them')
                break
            index += 2 if GOLDEN_OPTIONS[flag] else 1
        if '--generate-regions' not in argv:
            problems.append(f'{u["name"]}: {FETCH} without --generate-regions writes no region')
        rest = [arg for arg in argv if arg != '--generate-regions']
        if golden(u['name'], u['shard'], *rest)['outputs'] != u['outputs']:
            problems.append(f'{u["name"]}: its outputs are not the files its arguments collect')
    return problems


def lint():
    problems = []
    generators = {os.path.basename(u['argv'][0]) for u in UNITS}
    for u in UNITS:
        path = REPO / u['argv'][0]
        if not (path.is_file() and os.access(path, os.X_OK)):
            problems.append(f'{u["name"]}: {u["argv"][0]} is missing or not executable')
        if not (u['argv'][0] == FETCH or u['argv'][0].startswith(ANALYSIS)):
            problems.append(f'{u["name"]}: {u["argv"][0]} is neither under {ANALYSIS} nor {FETCH}')
    names = [u['name'] for u in UNITS]
    problems += [f'unit {n} is listed twice' for n in sorted({n for n in names if names.count(n) > 1})]
    paths = [(root_of(out), path_of(out)) for out in outputs(UNITS)]
    problems += [f'output {p!r} must be a plain path under {r}/' for r, p in paths
                 if r not in (PROBES, REGIONS) or p.startswith('/') or '..' in p.split('/') or not p]
    for i, (root_a, a) in enumerate(paths):
        for root_b, b in paths[i + 1:]:
            if root_a == root_b and (a == b or a.startswith(b + '/') or b.startswith(a + '/')):
                problems.append(f'two outputs overlap: {root_a}/{a} and {root_b}/{b}')
    for shard in SHARDS:
        roots = {root_of(out) for u in UNITS if u['shard'] == shard for out in u['outputs']}
        if len(roots) != 1:
            problems.append(f'shard {shard} writes into {sorted(roots)}; CI caches one tree a shard')
    problems += lint_goldens()
    for path in sorted((REPO / ANALYSIS).glob('*-probe.sh')):
        if path.name not in generators and path.name not in EXEMPT:
            problems.append(f'{ANALYSIS}{path.name} is neither a unit nor exempt: add it to UNITS '
                            '(CI then generates it) or to EXEMPT with the reason it is not')
    for name in sorted(EXEMPT):
        if name in generators:
            problems.append(f'{name} is both a unit and exempt')
        elif not (REPO / ANALYSIS / name).is_file():
            problems.append(f'{name} is exempt but does not exist')

    workflow = REPO / '.github/workflows/ci.yml'
    try:
        text = workflow.read_text(encoding='utf-8')
    except OSError as error:
        problems.append(f'cannot read {workflow}: {error}')
        text = ''
    if text:
        matrix = re.search(r'^\s*shard:\s*\[([^\]]*)\]', text, re.M)
        listed = [s.strip() for s in matrix.group(1).split(',')] if matrix else []
        if sorted(listed) != sorted(SHARDS):
            problems.append(f'ci.yml probes matrix lists {listed}, the table has {SHARDS}')
        restored = set(re.findall(r'steps\.probe-keys\.outputs\.([a-z0-9-]+)', text))
        if restored != set(SHARDS):
            problems.append(f'ci.yml restores shards {sorted(restored)}, the table has {sorted(SHARDS)}')
        # Each restore unpacks into its shard's own tree: an Actions cache
        # entry is looked up by its key AND its path, so a `path:` line sits
        # directly above every `key:` line.
        cached = re.compile(r'^[ \t]*path:[ \t]*(\S[^\n]*?)[ \t]*\n[ \t]*key:[ \t]*'
                            r'\$\{\{ steps\.(probe-keys\.outputs\.[a-z0-9-]+|key\.outputs\.key) \}\}',
                            re.M)
        pairs = cached.findall(text)
        with_path = {source.rsplit('.', 1)[1] for _, source in pairs if source.startswith('probe-keys')}
        if with_path != set(SHARDS):
            problems.append(f'ci.yml restores {sorted(set(SHARDS) - with_path)} without a path line '
                            'directly above the key')
        for path, source in pairs:
            shard = source.rsplit('.', 1)[1]
            if source.startswith('probe-keys') and shard in SHARDS \
                    and path != f'.fixtures/${{{{ env.MINECRAFT_VERSION }}}}/{shard_root(shard)}':
                problems.append(f'ci.yml restores shard {shard} into {path}, but it is cached as '
                                f'.fixtures/<version>/{shard_root(shard)}')
            # ... and the probes job caches the tree `key` names, never a fixed one.
            if source == 'key.outputs.key' and path != '${{ steps.key.outputs.path }}':
                problems.append(f'ci.yml probes job caches {path}, not ${{{{ steps.key.outputs.path }}}}')
        version = re.search(r'^\s*MINECRAFT_VERSION:\s*"([^"]+)"', text, re.M)
        if not version or version.group(1) != VERSION:
            problems.append(f'ci.yml MINECRAFT_VERSION is not {VERSION}')
    if problems:
        print(f'{len(problems)} problem(s):', file=sys.stderr)
        print('\n'.join('  ' + p for p in problems), file=sys.stderr)
        return 1
    print(f'ok: {len(UNITS)} unit(s) in {len(SHARDS)} shard(s), {len(EXEMPT)} exempt probe script(s)')
    return 0


def main():
    parser = argparse.ArgumentParser(prog='tools/probe-worlds', description=__doc__.split('\n')[0])
    sub = parser.add_subparsers(dest='command', required=True)
    for name in ('generate', 'verify'):
        p = sub.add_parser(name)
        p.add_argument('--shard')
        p.add_argument('--only', metavar='GLOB', help='unit name or generator basename')
        if name == 'generate':
            p.add_argument('--accept-eula', action='store_true')
        else:
            p.add_argument('--fixtures', type=pathlib.Path, default=REPO / '.fixtures')
    sub.add_parser('shards')
    sub.add_parser('keys')
    sub.add_parser('inventory')
    sub.add_parser('lint')
    sub.add_parser('key').add_argument('shard')
    args = parser.parse_args()

    if args.command == 'generate':
        if not args.accept_eula:
            die('this runs the Minecraft server, so it needs --accept-eula (verify only checks)')
        return generate(select(args.shard, args.only))
    if args.command == 'verify':
        return verify(select(args.shard, args.only), args.fixtures)
    if args.command == 'shards':
        print('\n'.join(SHARDS))
    elif args.command == 'key':
        # The cached path is the shard's tree, never the other one, so a
        # goldens entry and a probe entry never overwrite one another.
        print(f'key={key(args.shard)}\npath=.fixtures/{VERSION}/{shard_root(args.shard)}')
    elif args.command == 'keys':
        print('\n'.join(f'{shard}={key(shard)}' for shard in SHARDS))
    elif args.command == 'inventory':
        print(json.dumps({'version': VERSION, 'shards': SHARDS, 'units': UNITS,
                          'roots': {shard: shard_root(shard) for shard in SHARDS},
                          'golden_seeds': GOLDEN_SEEDS, 'exempt': sorted(EXEMPT)}, indent=1))
    elif args.command == 'lint':
        return lint()
    return 0


if __name__ == '__main__':
    sys.exit(main())
