#!/usr/bin/env bash
# Stratum — obtain vanilla worldgen data and conformance fixtures.
# Copyright 2026 the Stratum contributors. SPDX-License-Identifier: Apache-2.0
#
# NOTHING THIS SCRIPT PRODUCES MAY BE COMMITTED (SPEC §12). Everything it
# writes is derived from Mojang data: the repository ships this script, the
# user supplies the jar. The default output directory is .fixtures/, which
# .gitignore excludes, and tools/lint/check-determinism.sh fails the build if
# a jar or region file appears in the tree.
#
# Trust chain, verified at every hop:
#   version_manifest_v2.json  -> sha1 of the per-version metadata
#   <version>.json            -> sha1 of the published server jar
#   server.jar                -> checked before it is opened
#   META-INF/versions.list    -> sha256 of the nested server jar (bundler
#                                jars, i.e. everything since 1.18)
set -euo pipefail

# Keep in sync with SPEC §3 and STRATUM_MINECRAFT_VERSION in CMakeLists.txt.
readonly PINNED_VERSION="1.21.11"
readonly PACK_FORMAT_MAJOR=94
readonly PACK_FORMAT_MINOR=1
readonly MANIFEST_URL="https://piston-meta.mojang.com/mc/game/version_manifest_v2.json"
readonly WORLDGEN_PREFIX="data/minecraft/worldgen"
readonly STRUCTURE_PREFIX="data/minecraft/structure"

# The fixed seed set (SPEC §7). Deliberately includes 0, the negatives, and
# the extremes of the 64-bit range, because seed derivation is where sign
# handling goes wrong.
readonly DEFAULT_SEEDS="0,1,-1,42,-4172144997902289642,2891948927356891,9223372036854775807,-9223372036854775808"

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

version="${PINNED_VERSION}"
output_dir=""
jar_path=""
dry_run=0
skip_verify=0
accept_eula=0
generate_regions=0
with_structures=0
seeds=""
dimensions="overworld,nether,end"
regions="0,0"
margin=4
terrain_only=1
heap="2G"
generation_timeout=1800
keep_servers=0
freeze_ticks=1

usage() {
    cat <<'USAGE'
usage: tools/fetch-vanilla [options]

Downloads (or accepts) an official Minecraft server jar, verifies it, and
extracts the vanilla worldgen definitions used as conformance input.

options:
  --version <id>     Minecraft version to fetch (default: the pinned 1.21.11)
  --output <dir>     where fixtures are written (default: <repo>/.fixtures/<id>)
  --jar <path>       use a jar you already downloaded instead of fetching one
  --with-structures  also extract the vanilla structure NBT files, which the
                     harness uses as real input for its NBT reader tests
  --generate-regions also produce golden region files by running the server
  --accept-eula      you accept Mojang's EULA; required by --generate-regions
  --seeds <list>     comma-separated seeds (default: the fixed eight)
  --dimensions <l>   comma-separated: overworld,nether,end (default: all)
  --regions <list>   comma-separated region coordinates as X,Z pairs, e.g.
                     "0,0 -1,-1" (default: 0,0)
  --margin <n>       chunks generated around each region so its own chunks
                     reach full status (default: 4)
  --with-features    keep carvers and features; by default a generated
                     datapack strips them so the goldens isolate Tier A
  --heap <size>      server heap, passed to java -Xmx (default: 2G)
  --keep-servers     keep each server's working directory for inspection
  --no-freeze-ticks  let the world tick while generating; fluids then flow
                     between generation and saving, and two runs of the same
                     seed no longer agree (measured: 197 blocks differed)
  --skip-verify      do not check the jar's SHA-1 (for a jar not on the
                     manifest, e.g. a modified build; unsafe for conformance)
  --dry-run          print what would happen; performs no network access
  -h, --help         this message

Nothing written by this script may be committed: it is Mojang-derived data
(SPEC §12).
USAGE
}

log()  { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

require_tools() {
    local missing=()
    for tool in "$@"; do
        command -v "${tool}" >/dev/null 2>&1 || missing+=("${tool}")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        die "missing required tool(s): ${missing[*]}"
    fi
}

# macOS ships shasum rather than sha1sum.
sha1_of() {
    if command -v sha1sum >/dev/null 2>&1; then
        sha1sum "$1" | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 1 "$1" | cut -d' ' -f1
    else
        die "neither sha1sum nor shasum is available; cannot verify downloads"
    fi
}

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | cut -d' ' -f1
    else
        die "neither sha256sum nor shasum is available; cannot verify the bundle"
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --version)          version="${2:?--version needs an argument}"; shift 2 ;;
        --output)           output_dir="${2:?--output needs an argument}"; shift 2 ;;
        --jar)              jar_path="${2:?--jar needs an argument}"; shift 2 ;;
        --with-structures)  with_structures=1; shift ;;
        --seeds)            seeds="${2:?--seeds needs an argument}"; shift 2 ;;
        --dimensions)       dimensions="${2:?--dimensions needs an argument}"; shift 2 ;;
        --regions)          regions="${2:?--regions needs an argument}"; shift 2 ;;
        --margin)           margin="${2:?--margin needs an argument}"; shift 2 ;;
        --with-features)    terrain_only=0; shift ;;
        --heap)             heap="${2:?--heap needs an argument}"; shift 2 ;;
        --keep-servers)     keep_servers=1; shift ;;
        --no-freeze-ticks)  freeze_ticks=0; shift ;;
        --generate-regions) generate_regions=1; shift ;;
        --accept-eula)      accept_eula=1; shift ;;
        --skip-verify)      skip_verify=1; shift ;;
        --dry-run)          dry_run=1; shift ;;
        -h|--help)          usage; exit 0 ;;
        *)                  usage >&2; die "unknown option: $1" ;;
    esac
done

: "${output_dir:="${repo_root}/.fixtures/${version}"}"
readonly jar_file="${output_dir}/server-${version}.jar"
readonly worldgen_dir="${output_dir}/worldgen"
readonly structure_dir="${output_dir}/structure"
readonly biome_parameters_dir="${output_dir}/biome_parameters"
readonly regions_dir="${output_dir}/regions"
readonly provenance_file="${output_dir}/PROVENANCE.json"

if [[ "${version}" != "${PINNED_VERSION}" ]]; then
    warn "requested ${version}, but this engine is pinned to ${PINNED_VERSION} (SPEC §3)."
    warn "Conformance results against another version are not meaningful until the"
    warn "pin is moved deliberately: schema diff, regenerated goldens, matrix re-check."
fi

if [[ ${dry_run} -eq 1 ]]; then
    log "dry run — no network access, nothing written"
    echo "  version          : ${version}"
    echo "  manifest         : ${MANIFEST_URL}"
    echo "  output directory : ${output_dir}"
    if [[ -n "${jar_path}" ]]; then
        echo "  jar              : ${jar_path} (supplied by you)"
    else
        echo "  jar              : downloaded to ${jar_file}"
    fi
    echo "  worldgen JSON    : ${worldgen_dir} (from ${WORLDGEN_PREFIX}/** inside the jar)"
    echo "  biome parameters : ${biome_parameters_dir} (dumped by the server's own data
                       generator; the jar ships only a preset name)"
    echo "  provenance       : ${provenance_file}"
    echo "  verify SHA-1     : $([[ ${skip_verify} -eq 1 ]] && echo no || echo yes)"
    echo "  structures       : $([[ ${with_structures} -eq 1 ]] && echo "${structure_dir}" || echo no)"
    echo "  region goldens   : $([[ ${generate_regions} -eq 1 ]] && echo requested || echo no)"
    exit 0
fi

require_tools curl jq unzip

mkdir -p "${output_dir}"

# --- 1. resolve the version metadata ------------------------------------
metadata_file="${output_dir}/${version}.json"
if [[ -n "${jar_path}" && ${skip_verify} -eq 1 ]]; then
    log "using ${jar_path} without verification (--skip-verify)"
    metadata_sha1="(not verified)"
    jar_sha1_expected="(not verified)"
    metadata_url="(not fetched)"
else
    log "resolving ${version} from the Mojang version manifest"
    manifest_file="${output_dir}/version_manifest_v2.json"
    curl -fsSL "${MANIFEST_URL}" -o "${manifest_file}"

    metadata_url="$(jq -r --arg v "${version}" \
        '.versions[] | select(.id == $v) | .url' "${manifest_file}")"
    metadata_sha1="$(jq -r --arg v "${version}" \
        '.versions[] | select(.id == $v) | .sha1' "${manifest_file}")"
    [[ -n "${metadata_url}" && "${metadata_url}" != "null" ]] \
        || die "version ${version} is not in the Mojang manifest"

    curl -fsSL "${metadata_url}" -o "${metadata_file}"
    actual="$(sha1_of "${metadata_file}")"
    [[ "${actual}" == "${metadata_sha1}" ]] \
        || die "metadata SHA-1 mismatch for ${version}: expected ${metadata_sha1}, got ${actual}"
    log "metadata verified (${metadata_sha1})"

    jar_sha1_expected="$(jq -r '.downloads.server.sha1' "${metadata_file}")"
    jar_url="$(jq -r '.downloads.server.url' "${metadata_file}")"
    jar_size="$(jq -r '.downloads.server.size' "${metadata_file}")"
    required_java="$(jq -r '.javaVersion.majorVersion // "unknown"' "${metadata_file}")"
fi

# --- 2. obtain the server jar -------------------------------------------
if [[ -n "${jar_path}" ]]; then
    [[ -f "${jar_path}" ]] || die "no such jar: ${jar_path}"
    log "using the jar you supplied: ${jar_path}"
    jar_to_read="${jar_path}"
else
    if [[ -f "${jar_file}" ]] && [[ "$(sha1_of "${jar_file}")" == "${jar_sha1_expected}" ]]; then
        log "server jar already present and verified, skipping download"
    else
        log "downloading server jar (${jar_size} bytes) from ${jar_url}"
        curl -fL --progress-bar "${jar_url}" -o "${jar_file}"
    fi
    jar_to_read="${jar_file}"
fi

if [[ ${skip_verify} -eq 0 ]]; then
    actual="$(sha1_of "${jar_to_read}")"
    [[ "${actual}" == "${jar_sha1_expected}" ]] \
        || die "jar SHA-1 mismatch: expected ${jar_sha1_expected}, got ${actual}"
    log "jar verified (${jar_sha1_expected})"
fi

# --- 3. unwrap the bundler ----------------------------------------------
# Since 1.18 the published server jar is a launcher: the real server sits at
# META-INF/versions/<id>/server-<id>.jar and META-INF/versions.list records
# its SHA-256. The worldgen data is in there, not in the outer jar.
data_jar="${jar_to_read}"
nested_sha256=""
versions_list="${output_dir}/versions.list"
if unzip -p "${jar_to_read}" "META-INF/versions.list" > "${versions_list}" 2>/dev/null \
        && [[ -s "${versions_list}" ]]; then
    log "bundler jar detected; unwrapping the nested server jar"

    # Format: <sha256>\t<id>\t<path relative to META-INF/versions/>.
    # Prefer the entry matching the requested version, else the first.
    nested_line="$(awk -F'\t' -v want="${version}" \
        '$2 == want { print; found = 1; exit } END { if (!found) exit 1 }' \
        "${versions_list}" || head -n 1 "${versions_list}")"
    nested_sha256="$(cut -f1 <<<"${nested_line}")"
    nested_path="$(cut -f3 <<<"${nested_line}" | tr -d '\r\n')"
    [[ -n "${nested_path}" ]] || die "META-INF/versions.list is malformed: '${nested_line}'"

    bundle_dir="${output_dir}/.bundle"
    rm -rf "${bundle_dir}"
    mkdir -p "${bundle_dir}"
    unzip -qo "${jar_to_read}" "META-INF/versions/${nested_path}" -d "${bundle_dir}" \
        || die "bundler lists META-INF/versions/${nested_path} but the jar does not contain it"
    data_jar="${bundle_dir}/META-INF/versions/${nested_path}"

    # Checked even under --skip-verify: that flag waives *provenance* (is
    # this Mojang's jar?), while this is internal consistency (is this jar
    # intact?). A bundle whose own manifest disagrees with its contents is
    # corrupt no matter where it came from.
    actual="$(sha256_of "${data_jar}")"
    [[ "${actual}" == "${nested_sha256}" ]] \
        || die "nested server jar SHA-256 mismatch: META-INF/versions.list says
       ${nested_sha256}
       but the embedded jar hashes to
       ${actual}
       This jar is corrupt or repackaged; refusing to extract from it."
    log "nested server jar verified (${nested_sha256})"
fi

# --- 4. extract the worldgen definitions --------------------------------
log "extracting ${WORLDGEN_PREFIX}/** into ${worldgen_dir}"
rm -rf "${worldgen_dir}"
staging_dir="${output_dir}/.extract"
rm -rf "${staging_dir}"
mkdir -p "${staging_dir}"
# `unzip -j` would flatten the namespaced paths that references depend on, so
# the tree is extracted intact and then rerooted at worldgen_dir, leaving
# paths like `noise_settings/overworld.json` — the shape a `minecraft:` id
# resolves to.
unzip -qo "${data_jar}" "${WORLDGEN_PREFIX}/*" -d "${staging_dir}" >/dev/null 2>&1 || true
[[ -d "${staging_dir}/${WORLDGEN_PREFIX}" ]] \
    || die "${data_jar} contains no ${WORLDGEN_PREFIX}/ entries.
       A modern server jar is a bundler and the data lives in the nested jar
       under META-INF/versions/; this one has neither. Is it a client jar, or
       a repackaged build?"
mkdir -p "$(dirname "${worldgen_dir}")"
mv "${staging_dir}/${WORLDGEN_PREFIX}" "${worldgen_dir}"
rm -rf "${staging_dir}"

json_count="$(find "${worldgen_dir}" -name '*.json' -type f | wc -l | tr -d ' ')"
[[ "${json_count}" -gt 0 ]] || die "extracted no worldgen JSON from ${data_jar}"
log "extracted ${json_count} worldgen JSON files"

# Structure NBT is not worldgen input; it is the only real, vanilla-written
# NBT available without running a server, so the NBT reader's conformance
# test parses it. Same rule as everything else here: never committed.
structure_count=0
if [[ ${with_structures} -eq 1 ]]; then
    log "extracting ${STRUCTURE_PREFIX}/** into ${structure_dir}"
    rm -rf "${structure_dir}"
    structure_staging="${output_dir}/.extract-structure"
    rm -rf "${structure_staging}"
    mkdir -p "${structure_staging}"
    unzip -qo "${data_jar}" "${STRUCTURE_PREFIX}/*" -d "${structure_staging}" >/dev/null 2>&1 || true
    [[ -d "${structure_staging}/${STRUCTURE_PREFIX}" ]] \
        || die "${data_jar} contains no ${STRUCTURE_PREFIX}/ entries"
    mv "${structure_staging}/${STRUCTURE_PREFIX}" "${structure_dir}"
    rm -rf "${structure_staging}"
    structure_count="$(find "${structure_dir}" -name '*.nbt' -type f | wc -l | tr -d ' ')"
    log "extracted ${structure_count} structure NBT files"
fi

# The biome parameter table is not in the jar as data: at 1.21.11
# worldgen/multi_noise_biome_source_parameter_list/overworld.json is only
# {"preset": "minecraft:overworld"}, and the table itself is compiled in.
# The server will however dump it, and its own output is a permitted source
# where its code is not (CLAUDE.md). This is the only way to get the numbers
# M4's biome source needs without reading Mojang's code for them.
biome_parameter_count=0
log "asking the server to dump its biome parameters"
reports_staging="${output_dir}/.extract-reports"
rm -rf "${reports_staging}"
mkdir -p "${reports_staging}"
if (cd "${reports_staging}" && java \
        -DbundlerMainClass=net.minecraft.data.Main \
        -jar "${jar_file}" --reports >/dev/null 2>&1); then
    dumped="${reports_staging}/generated/reports/biome_parameters"
    if [[ -d "${dumped}" ]]; then
        rm -rf "${biome_parameters_dir}"
        mkdir -p "$(dirname "${biome_parameters_dir}")"
        mv "${dumped}" "${biome_parameters_dir}"
        biome_parameter_count="$(find "${biome_parameters_dir}" -name '*.json' -type f \
            | wc -l | tr -d ' ')"
        log "dumped ${biome_parameter_count} biome parameter list(s)"
    else
        log "warning: the server produced no biome_parameters; M4's biome source will skip"
    fi
else
    log "warning: could not run the data generator; M4's biome source will skip"
fi
rm -rf "${reports_staging}"

# --- 5. provenance record ------------------------------------------------
jq -n \
    --arg version "${version}" \
    --arg pinned "${PINNED_VERSION}" \
    --arg metadata_url "${metadata_url:-}" \
    --arg metadata_sha1 "${metadata_sha1:-}" \
    --arg jar_sha1 "${jar_sha1_expected:-}" \
    --arg nested_jar_sha256 "${nested_sha256:-}" \
    --arg jar_source "${jar_path:-${jar_url:-}}" \
    --argjson worldgen_files "${json_count}" \
    --argjson structure_files "${structure_count:-0}" \
    --argjson biome_parameter_files "${biome_parameter_count:-0}" \
    '{
        version: $version,
        pinned_version: $pinned,
        metadata_url: $metadata_url,
        metadata_sha1: $metadata_sha1,
        server_jar_sha1: $jar_sha1,
        nested_server_jar_sha256: $nested_jar_sha256,
        server_jar_source: $jar_source,
        worldgen_files: $worldgen_files,
        structure_files: $structure_files,
        biome_parameter_files: $biome_parameter_files,
        note: "Mojang-derived. Never commit anything in this directory (SPEC 12)."
    }' > "${provenance_file}"
log "wrote ${provenance_file}"

# --- 6. golden region files ----------------------------------------------

# Everything below runs the vanilla server headlessly and collects what it
# wrote. The engine's own output is never involved: these are Mojang's
# answers, which is the whole point of a conformance golden (SPEC §7).

dimension_directory() {
    case "$1" in
        overworld) echo "region" ;;
        nether)    echo "DIM-1/region" ;;
        end)       echo "DIM1/region" ;;
        *)         die "unknown dimension '$1' (expected overworld, nether or end)" ;;
    esac
}

dimension_id() {
    case "$1" in
        overworld) echo "minecraft:overworld" ;;
        nether)    echo "minecraft:the_nether" ;;
        end)       echo "minecraft:the_end" ;;
        *)         die "unknown dimension '$1'" ;;
    esac
}

# A datapack that empties every biome's carvers and features, so the goldens
# isolate what Tier A actually covers: density functions, noise, terrain
# shape, aquifers, biome assignment and surface rules. Carvers and features
# are Tier B (SPEC §7) and would otherwise be noise in every comparison.
write_terrain_only_datapack() {
    local world_dir="$1"
    local pack_dir="${world_dir}/datapacks/stratum-terrain-only"
    local biome_out="${pack_dir}/data/minecraft/worldgen/biome"

    [[ -d "${worldgen_dir}/biome" ]] \
        || die "cannot build the terrain-only datapack: ${worldgen_dir}/biome is missing"

    mkdir -p "${biome_out}"
    cat > "${pack_dir}/pack.mcmeta" <<PACK
{
  "pack": {
    "description": "Stratum conformance: carvers and features removed so goldens isolate Tier A",
    "min_format": [${PACK_FORMAT_MAJOR}, ${PACK_FORMAT_MINOR}],
    "max_format": ${PACK_FORMAT_MAJOR}
  }
}
PACK

    local count=0
    local biome
    for biome in "${worldgen_dir}"/biome/*.json; do
        # Keep the same number of decoration steps; vanilla expects them all.
        jq '.features = [range(.features | length) | []] | .carvers = []' \
            "${biome}" > "${biome_out}/$(basename "${biome}")"
        count=$((count + 1))
    done
    log "terrain-only datapack: ${count} biome(s) with carvers and features removed"
}

# /forceload accepts block coordinates and refuses more than 256 chunks at a
# time, so a region is requested as a grid of 16x16-chunk commands.
emit_forceload_commands() {
    local dimension_id="$1"
    local from_chunk_x="$2"
    local from_chunk_z="$3"
    local to_chunk_x="$4"
    local to_chunk_z="$5"

    local cx cz
    for (( cz = from_chunk_z; cz <= to_chunk_z; cz += 16 )); do
        for (( cx = from_chunk_x; cx <= to_chunk_x; cx += 16 )); do
            local end_x=$(( cx + 15 < to_chunk_x ? cx + 15 : to_chunk_x ))
            local end_z=$(( cz + 15 < to_chunk_z ? cz + 15 : to_chunk_z ))
            printf 'execute in %s run forceload add %d %d %d %d\n' \
                "${dimension_id}" $(( cx * 16 )) $(( cz * 16 )) \
                $(( end_x * 16 + 15 )) $(( end_z * 16 + 15 ))
        done
    done
}

# A server left running holds its world files open and would collide with the
# next run. Whatever happens — an error, or the user interrupting — the child
# is stopped before this script goes away.
running_server_pid=""

cleanup_server() {
    if [[ -n "${running_server_pid}" ]] && kill -0 "${running_server_pid}" 2>/dev/null; then
        printf '\nstopping the server (pid %s)\n' "${running_server_pid}" >&2
        kill "${running_server_pid}" 2>/dev/null || true
        local waited=0
        while kill -0 "${running_server_pid}" 2>/dev/null && (( waited < 20 )); do
            sleep 1
            waited=$((waited + 1))
        done
        kill -9 "${running_server_pid}" 2>/dev/null || true
    fi
    running_server_pid=""
}

trap cleanup_server EXIT INT TERM

generate_for_seed() {
    local seed="$1"
    local server_dir="${output_dir}/servers/seed-${seed}"
    local world_dir="${server_dir}/world"
    local log_file="${server_dir}/server.log"
    local pipe="${server_dir}/console"

    rm -rf "${server_dir}"
    mkdir -p "${server_dir}" "${world_dir}"

    # The EULA is accepted by the person who passed --accept-eula, and this
    # file records their decision. The script never writes it otherwise.
    printf 'eula=true\n' > "${server_dir}/eula.txt"

    # server-port=0 asks for any free port. Nothing ever connects to this
    # server, and a fixed port would make two generation runs — or a running
    # game — collide.
    #
    # max-tick-time=-1 disables the watchdog. Generating a region across three
    # dimensions can legitimately hold the main thread for over a minute, and
    # the watchdog's answer to that is to declare the server crashed and kill
    # it mid-generation. Observed exactly that: "A single server tick took
    # 60.00 seconds ... Considering it to be crashed".
    cat > "${server_dir}/server.properties" <<PROPERTIES
level-seed=${seed}
level-name=world
online-mode=false
server-port=0
max-players=1
spawn-protection=0
view-distance=10
simulation-distance=10
generate-structures=$([[ ${with_structures} -eq 1 ]] && echo true || echo false)
spawn-monsters=false
spawn-npcs=false
spawn-animals=false
sync-chunk-writes=true
enable-command-block=false
max-tick-time=-1
motd=stratum conformance fixture generation
PROPERTIES

    if [[ ${terrain_only} -eq 1 ]]; then
        write_terrain_only_datapack "${world_dir}"
    fi

    log "seed ${seed}: starting the server"
    rm -f "${pipe}"
    mkfifo "${pipe}"
    ( cd "${server_dir}" && java "-Xmx${heap}" -jar "${jar_to_read_absolute}" --nogui \
        < "${pipe}" > "${log_file}" 2>&1 ) &
    local server_pid=$!
    running_server_pid="${server_pid}"
    # Holding the write end open keeps the server's stdin from closing.
    exec 3> "${pipe}"

    local waited=0
    until grep -q 'Done (' "${log_file}" 2>/dev/null; do
        sleep 2
        waited=$((waited + 2))
        if ! kill -0 "${server_pid}" 2>/dev/null; then
            exec 3>&-
            tail -20 "${log_file}" >&2
            die "seed ${seed}: the server exited during startup (see ${log_file})"
        fi
        if [[ ${waited} -gt 300 ]]; then
            exec 3>&-
            kill "${server_pid}" 2>/dev/null || true
            die "seed ${seed}: the server did not finish starting within 300s"
        fi
    done
    log "seed ${seed}: server up after ${waited}s"

    # Worldgen is deterministic; the ticking world on top of it is not.
    # Fluids keep flowing after a chunk is generated, so how much lava has
    # spread by the time the region is saved depends on wall-clock timing.
    # Two runs of this same seed differed in 197 blocks — all flowing lava,
    # flowing water, and the cobblestone where they met — until the world
    # was frozen first. Aquifer fill is Tier A (SPEC §7), so those blocks
    # cannot simply be ignored in the comparison; they have to not happen.
    if [[ ${freeze_ticks} -eq 1 ]]; then
        log "seed ${seed}: freezing the world before generating"
        printf 'tick freeze\n' >&3
        sleep 2
        if ! grep -q -i 'frozen' "${log_file}"; then
            exec 3>&-
            kill "${server_pid}" 2>/dev/null || true
            die "seed ${seed}: 'tick freeze' was not acknowledged; this server may not
       support it. Re-run with --no-freeze-ticks, but note that goldens will
       then depend on wall-clock timing."
        fi
    fi

    local -a expected_files=()
    local dimension region
    for dimension in ${dimensions//,/ }; do
        local dim_id
        dim_id="$(dimension_id "${dimension}")"
        for region in ${regions}; do
            local region_x="${region%%,*}"
            local region_z="${region##*,}"
            local from_x=$(( region_x * 32 - margin ))
            local from_z=$(( region_z * 32 - margin ))
            local to_x=$(( region_x * 32 + 31 + margin ))
            local to_z=$(( region_z * 32 + 31 + margin ))

            log "seed ${seed}: forceloading ${dimension} r.${region_x}.${region_z}" \
                "(chunks ${from_x}..${to_x} x ${from_z}..${to_z}, margin ${margin})"
            emit_forceload_commands "${dim_id}" "${from_x}" "${from_z}" "${to_x}" "${to_z}" >&3

            expected_files+=("${world_dir}/$(dimension_directory "${dimension}")/r.${region_x}.${region_z}.mca")
        done
    done

    # Generation happens over ticks, so the finish line is "every expected
    # region file exists and has stopped changing", not a log line.
    log "seed ${seed}: generating (timeout ${generation_timeout}s)"
    local stable=0
    local previous_sizes=""
    waited=0
    while (( waited < generation_timeout )); do
        # Writing to the console of a server that has died raises SIGPIPE and
        # would take this script down with no explanation, so its liveness is
        # checked first and its own log is surfaced.
        if ! kill -0 "${server_pid}" 2>/dev/null; then
            exec 3>&- || true
            printf 'last 20 lines of %s:\n' "${log_file}" >&2
            tail -20 "${log_file}" >&2
            die "seed ${seed}: the server died during generation. Its log is above, and
       any crash report is under ${server_dir}/crash-reports/."
        fi

        printf 'save-all flush\n' >&3 || true
        sleep 10
        waited=$((waited + 10))

        local all_present=1
        local sizes=""
        local file
        for file in "${expected_files[@]}"; do
            if [[ -f "${file}" ]]; then
                sizes+="$(wc -c < "${file}") "
            else
                all_present=0
                sizes+="- "
            fi
        done

        if [[ ${all_present} -eq 1 && "${sizes}" == "${previous_sizes}" ]]; then
            stable=$((stable + 1))
            if [[ ${stable} -ge 2 ]]; then
                break
            fi
        else
            stable=0
        fi
        previous_sizes="${sizes}"
    done

    if [[ ${stable} -lt 2 ]]; then
        printf 'stop\n' >&3 || true
        exec 3>&-
        die "seed ${seed}: region files did not settle within ${generation_timeout}s.
       Raise the timeout, lower --margin, or ask for fewer regions."
    fi
    log "seed ${seed}: generation settled after ${waited}s"

    printf 'stop\n' >&3
    exec 3>&-
    local stopping=0
    while kill -0 "${server_pid}" 2>/dev/null; do
        sleep 2
        stopping=$((stopping + 2))
        if [[ ${stopping} -gt 120 ]]; then
            kill "${server_pid}" 2>/dev/null || true
            break
        fi
    done
    wait "${server_pid}" 2>/dev/null || true
    running_server_pid=""
    rm -f "${pipe}"

    # Collect only the regions asked for; the margin lives in neighbouring
    # region files and is discarded.
    for dimension in ${dimensions//,/ }; do
        for region in ${regions}; do
            local region_x="${region%%,*}"
            local region_z="${region##*,}"
            local source_file="${world_dir}/$(dimension_directory "${dimension}")/r.${region_x}.${region_z}.mca"
            local target_dir="${regions_dir}/seed-${seed}/${dimension}"
            [[ -f "${source_file}" ]] || die "seed ${seed}: ${source_file} was never written"
            mkdir -p "${target_dir}"
            cp "${source_file}" "${target_dir}/r.${region_x}.${region_z}.mca"
            log "seed ${seed}: collected ${dimension}/r.${region_x}.${region_z}.mca ($(wc -c < "${source_file}") bytes)"
        done
    done

    if [[ ${keep_servers} -eq 0 ]]; then
        rm -rf "${server_dir}"
    fi
}

if [[ ${generate_regions} -eq 1 ]]; then
    if [[ ${accept_eula} -eq 0 ]]; then
        die "--generate-regions runs the vanilla server, which requires accepting
       Mojang's EULA (https://aka.ms/MinecraftEULA). Re-run with --accept-eula
       once you have read and accepted it. This script will not accept it on
       your behalf."
    fi

    require_tools java
    [[ -n "${jar_path}" ]] && jar_to_read_absolute="$(cd "$(dirname "${jar_path}")" && pwd)/$(basename "${jar_path}")" \
        || jar_to_read_absolute="${jar_file}"

    if [[ "${required_java:-unknown}" != "unknown" ]]; then
        running_java="$(java -version 2>&1 | head -1)"
        log "server targets Java ${required_java}; using ${running_java}"
    fi

    # Validated before any server starts: a typo should cost a second, not a
    # six-second startup followed by a confusing failure mid-run.
    for dimension in ${dimensions//,/ }; do
        dimension_id "${dimension}" > /dev/null
    done
    for region in ${regions}; do
        [[ "${region}" =~ ^-?[0-9]+,-?[0-9]+$ ]] \
            || die "malformed region coordinate '${region}': expected X,Z (for example 0,0 or -1,-1)"
    done
    [[ "${margin}" =~ ^[0-9]+$ ]] || die "--margin must be a non-negative whole number"

    [[ -z "${seeds}" ]] && seeds="${DEFAULT_SEEDS}"
    log "generating goldens for seeds ${seeds}, dimensions ${dimensions}, regions ${regions}"

    for seed in ${seeds//,/ }; do
        generate_for_seed "${seed}"
    done

    region_count="$(find "${regions_dir}" -name '*.mca' -type f 2>/dev/null | wc -l | tr -d ' ')"
    log "collected ${region_count} golden region file(s) into ${regions_dir}"
fi

rm -rf "${output_dir}/.bundle"
log "done. Fixtures in ${output_dir} — do not commit them."
