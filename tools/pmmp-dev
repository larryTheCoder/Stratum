rest=()

parse_options() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --stratum-so) so="$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"; shift 2 ;;
            --version-root) version_root="$2"; shift 2 ;;
            --dimension) dimension="$2"; shift 2 ;;
            --seed) seed="$2"; shift 2 ;;
            --port) port="$2"; shift 2 ;;
            --async-workers) async_workers="$2"; shift 2 ;;
            --timeout) timeout="$2"; shift 2 ;;
            --work-dir) work_dir="$2"; shift 2 ;;
            --keep) keep=1; shift ;;
            --no-netns) netns=0; shift ;;
            --build-php-config) build_php_config="$2"; shift 2 ;;
            --report) report="$2"; shift 2 ;;
            --fixtures-dir) fixtures_dir="$2"; shift 2 ;;
            --max-discards)
                [[ "$2" =~ ^[0-9]+$ ]] || die "--max-discards takes a count, not $2"
                max_discards="$2"
                shift 2
                ;;
            --plugin-dir) plugin_dir="$2"; shift 2 ;;
            --) shift; rest=("$@"); return ;;
            *) die "unknown option $1" ;;
        esac
    done
}

dimension_pair() {
    case "${dimension}" in
        overworld) echo "minecraft:overworld minecraft:overworld" ;;
        end) echo "minecraft:end minecraft:the_end" ;;
        *) die "--dimension is overworld or end, not ${dimension}" ;;
    esac
}

# --- check-load -----------------------------------------------------------------

abi_lines() {
    "$1" -n -i | grep -E '^(PHP API|PHP Extension|Zend Extension|PHP Extension Build|Debug Build|Thread Safety|Zend Signal Handling|Zend Memory Manager|Zend Max Execution Timers) =>'
}

cmd_check_load() {
    require_cache
    require_so "${so}"
    local failures=0

    local module_id php_id
    # every build id string in the module, read to the end (no early-exiting
    # reader for grep to write into under pipefail); exactly one is expected
    module_id="$(LC_ALL=C grep -aoE 'API[0-9]{8},(NTS|TS)(,debug)?' "${so}" | LC_ALL=C sort -u)" || true
    php_id="$("${php_bin}" -n -i | sed -n 's/^PHP Extension Build => //p')"
    echo "stratum.so module build id: ${module_id:-none found}"
    echo "PocketMine-MP's php build id: ${php_id}"
    [[ -n "${module_id}" && "${module_id}" == "${php_id}" ]] || {
        echo "FAIL: the build ids differ"
        failures=$((failures + 1))
    }

    echo "PocketMine-MP's php:"
    abi_lines "${php_bin}" | sed 's/^/  /'
    if [[ -n "${build_php_config}" ]]; then
        local build_php
        build_php="$("${build_php_config}" --php-binary)"
        echo "the php stratum.so was built against (${build_php}):"
        abi_lines "${build_php}" | sed 's/^/  /'
        if ! diff <(abi_lines "${build_php}") <(abi_lines "${php_bin}") >/dev/null; then
            echo "FAIL: the two PHPs differ in a line above"
            failures=$((failures + 1))
        fi
    fi

    if command -v nm >/dev/null 2>&1; then
        local unresolved
        unresolved="$(LC_ALL=C comm -23 \
            <(nm -D --undefined-only "${so}" | awk '{print $2}' | grep -v '@' | grep -vE '^(_ITM_|__gmon_start__)' | LC_ALL=C sort -u) \
            <(nm -D --defined-only "${php_bin}" | awk '{print $3}' | LC_ALL=C sort -u))"
        if [[ -n "${unresolved}" ]]; then
            echo "FAIL: stratum.so needs symbols PocketMine-MP's php does not export: ${unresolved//$'\n'/ }"
            failures=$((failures + 1))
        else
            echo "every zend symbol stratum.so imports is exported by PocketMine-MP's php"
        fi
    else
        echo "(no nm: the symbol check is not run)"
    fi

    local loaded
    loaded="$("${php_bin}" -n -d extension="${so}" -r '
        echo implode(" ", get_loaded_extensions()), "\n";
        echo "stratum ", phpversion("stratum"), ": ", Stratum\javaBlockStateCount(), " Java block states\n";' 2>&1)" || true
    echo "loaded into PocketMine-MP's php: ${loaded}"
    if grep -Eqi 'warning|unable to load|module compiled|cannot load' <<<"${loaded}" ||
        ! grep -q '^stratum 0' <<<"${loaded}"; then
        echo "FAIL: stratum.so did not load cleanly"
        failures=$((failures + 1))
    fi
    local extension
    for extension in chunkutils2 pmmpthread leveldb igbinary morton encoding libdeflate crypto yaml; do
        grep -qw "${extension}" <<<"${loaded}" || {
            echo "FAIL: ${extension} is not loaded beside stratum"
            failures=$((failures + 1))
        }
    done

    # PocketMine-MP's own startup gate (check_platform_dependencies) runs
    # before --version prints, and exits 1 naming whatever it refuses. PHP
    # itself only warns about a module it could not load and runs on
    # without it, so that is a failure here too: the gate would have passed
    # without stratum.so.
    local tmp gate rc=0
    tmp="$(mktemp -d)"
    gate="$("${php_bin}" -n -d extension="${so}" -d phar.require_hash=1 -d memory_limit=1024M \
        -d zend.assertions=-1 -d sys_temp_dir="${tmp}" "${phar}" --version 2>&1)" || rc=$?
    rm -rf "${tmp}"
    echo "PocketMine-MP's startup gate, with stratum.so (exit ${rc}): ${gate}"
    if [[ ${rc} -ne 0 ]] || ! grep -q "PocketMine-MP ${PMMP_VERSION}" <<<"${gate}"; then
        echo "FAIL: PocketMine-MP refused this PHP environment"
        failures=$((failures + 1))
    fi
    if grep -Eqi 'Unable to initialize module|Module compiled|Unable to load' <<<"${gate}"; then
        echo "FAIL: PHP did not load stratum.so for PocketMine-MP's startup gate, which then ran without it"
        failures=$((failures + 1))
    fi

    [[ ${failures} -eq 0 ]] || exit 1
    echo "RESULT: PASS"
}

# --- server directory ---------------------------------------------------------

# refuse_in_checkout <dir>: a server or work directory inside this checkout
# and outside build/ would leave a frozen pipeline (Mojang-derived, SPEC §12)
# and LevelDB files one `git add -A` from a commit. Judged on the resolved
# path, so a relative <dir>, or one reached through a symlink, is caught too.
refuse_in_checkout() {
    local target checkout
    target="$(realpath -m -- "$1")"
    checkout="$(realpath -- "${repo_root}")"
    if [[ "${target}" == "${checkout}" || "${target}" == "${checkout}/"* ]] &&
        [[ "${target}" != "${checkout}/build/"* ]]; then
        die "refusing $1: it is inside this checkout (${checkout}) and not under its build/; use a directory under build/ or \$TMPDIR"
    fi
}

# write_server_dir <dir> [observe]: the server directory `server` describes;
# with "observe", the evidence plugin observes (cmd_observe).
write_server_dir() {
    local dir="$1" observe="${2:-}"
    local settings biomes
    read -r settings biomes < <(dimension_pair)
    local world="stratum_${dimension}"
    [[ -n "${port}" ]] || port=$([[ "${dimension}" == "overworld" ]] && echo 19842 || echo 19852)

    refuse_in_checkout "${dir}"
    if [[ -e "${dir}" ]]; then
        [[ -f "${dir}/.stratum-pmmp-server" || -z "$(ls -A "${dir}")" ]] ||
            die "${dir} exists and is not a server directory this tool wrote; refusing to touch it"
        rm -rf "${dir}"
    fi
    mkdir -p "${dir}/plugins" "${dir}/worlds/${world}" "${dir}/tmp"
    dir="$(cd "${dir}" && pwd)"
    : >"${dir}/.stratum-pmmp-server"
    # A second guard, wherever the directory is: it ignores itself.
    printf '# Written by tools/pmmp-dev: nothing in a server directory is ever committed.\n*\n' >"${dir}/.gitignore"

    # As WorldFactory does it: the blob in the world's own folder, before the
    # world exists; a folder holding only the blob is not a generated world.
    # And named as WorldFactory names it, relative to the server's data path
    # (which the plugin gives the extension in onLoad, and every generation
    # worker reads it against), so the world moves with the directory.
    local blob_rel="worlds/${world}/stratum-pipeline.blob"
    "${php_bin}" -n -d extension="${so}" -r 'Stratum\freezePipeline($argv[1], $argv[2]);' \
        "${version_root}" "${dir}/${blob_rel}"
    # The options string exactly as the plugin's own GeneratorOptions writes it.
    local options
    options="$("${php_bin}" -n -r 'require $argv[1]; echo Stratum\PMMP\GeneratorOptions::encode($argv[2], $argv[3], $argv[4]);' \
        "${plugin_dir}/src/GeneratorOptions.php" "${blob_rel}" "${settings}" "${biomes}")"
    printf '%s' "${options}" >"${dir}/generator-options.json"

    "${php_bin}" -n -d phar.readonly=0 "${evidence}/build_plugin_phar.php" \
        "${plugin_dir}" "${dir}/plugins/Stratum.phar" >&2

    # The evidence plugin (ext/pocketmine's plugin.yml and src/), when there
    # is something for it to do: the End's spawn over the main island, or
    # observing. The plugin under test is the same either way.
    local spawn=""
    [[ "${dimension}" == "end" ]] && spawn="0 70 0"
    if [[ -n "${spawn}" || "${observe}" == "observe" ]]; then
        "${php_bin}" -n -d phar.readonly=0 "${evidence}/build_plugin_phar.php" \
            "${evidence}" "${dir}/plugins/StratumEvidence.phar" >&2
        "${php_bin}" -n -r '
            [, $world, $spawn, $observe, $report] = $argv;
            echo json_encode([
                "world" => $world,
                "spawn" => $spawn === "" ? null : array_map(intval(...), explode(" ", $spawn)),
                "observe" => $observe === "observe",
                "report" => $report,
            ], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), "\n";' \
            "${world}" "${spawn}" "${observe}" "${dir}/stratum-evidence-report.json" >"${dir}/stratum-evidence.json"
    fi

    cat >"${dir}/php.ini" <<EOF
; Written by tools/pmmp-dev. pmmp/PHP-Binaries' own php.ini settings, with
; extension_dir pointed at this machine's copy (the release's compiled-in
; path is its CI runner's), temporary files kept inside the server directory
; (the phar's stub caches itself there), and stratum.so loaded. opcache.so
; is the release's own, which its php.ini enables, so the server runs as
; PocketMine-MP runs it. Read through PHPRC, so PocketMine-MP's console
; reader child process reads it too.
memory_limit=1024M
date.timezone=UTC
short_open_tag=0
phar.require_hash=1
igbinary.compact_strings=0
zend.assertions=-1
error_reporting=-1
display_errors=1
display_startup_errors=1
recursionguard.enabled=0
extension_dir="${php_ext_dir}"
zend_extension=opcache.so
opcache.enable=1
opcache.enable_cli=1
opcache.save_comments=1
opcache.validate_timestamps=1
opcache.revalidate_freq=0
opcache.file_update_protection=0
opcache.optimization_level=0x7FFEBFFF
sys_temp_dir="${dir}/tmp"
extension="${so}"
EOF

    cat >"${dir}/server.properties" <<EOF
#Properties Config file
# Written by tools/pmmp-dev: a hermetic, headless test server. Loopback only;
# IPv6 and Query off; Xbox Live authentication off, since it fetches
# Microsoft's keys when a client logs in; whitelisted, with nobody on it.
# The default world is the one pocketmine.yml's worlds: entry creates.
motd=Stratum smoke test
server-ip=127.0.0.1
server-port=${port}
server-ipv6=::1
server-portv6=$((port + 1))
enable-ipv6=off
enable-query=off
xbox-auth=off
white-list=on
max-players=1
level-name=${world}
level-seed=${seed}
view-distance=4
language=eng
EOF

    # Every pocketmine.yml switch that makes 5.44.3 reach the network, set
    # off explicitly: a key left out takes its default in the code, and
    # anonymous-statistics.enabled defaults to true there. The world is a
    # worlds: entry, generator "stratum" with the plugin's options as its
    # preset. Emitted by the yaml extension PocketMine-MP parses it with.
    "${php_bin}" -n -r '
        [, $workers, $world, $options, $seed] = $argv;
        echo "# Written by tools/pmmp-dev: a hermetic, headless test server.\n";
        echo yaml_emit([
            "settings" => ["query-plugins" => false, "enable-profiling" => false,
                "async-workers" => (int) $workers, "enable-dev-builds" => false],
            "network" => ["upnp-forwarding" => false],
            "debug" => ["level" => 2],
            "player" => ["save-player-data" => false],
            "auto-report" => ["enabled" => false, "send-code" => false, "send-settings" => false, "send-phpinfo" => false],
            "anonymous-statistics" => ["enabled" => false],
            "auto-updater" => ["enabled" => false, "suggest-channels" => false, "on-update" => ["warn-console" => false]],
            "console" => ["enable-input" => true, "title-tick" => false],
            "worlds" => [$world => ["generator" => "stratum", "preset" => $options, "seed" => (int) $seed]],
        ]);' "${async_workers}" "${world}" "${options}" "${seed}" >"${dir}/pocketmine.yml"

    log "server directory: ${dir} (world ${world}, ${settings} / ${biomes}, seed ${seed})"
}

cmd_server() {
    local dir="${1:-}"
    [[ -n "${dir}" && "${dir}" != --* ]] || die "usage: tools/pmmp-dev server <dir> --stratum-so <so> --version-root <root>"
    shift
    parse_options "$@"
    install_all
    require_so "${so}"
    require_version_root "${version_root}"
    write_server_dir "${dir}"
    # Absolute and quoted: the command cds into the directory first, and a
    # path relative to where this ran would then name nothing — PHP would
    # fall back to the release's own php.ini (no stratum.so) and
    # PocketMine-MP to a fresh --data directory with its own defaults, which
    # reach the network.
    dir="$(cd "${dir}" && pwd)"
    printf 'run it with: cd %q && PHPRC=%q PHP_INI_SCAN_DIR= %q %q --no-wizard --data=%q --plugins=%q\n' \
        "${dir}" "${dir}/php.ini" "${php_bin}" "${phar}" "${dir}" "${dir}/plugins"
}

# --- a running server -----------------------------------------------------------

server_dir=""
server_pid=""
console_fd=""
server_rc=0
server_stopped=0

# start_server <dir>: boots PocketMine-MP over a server directory this tool
# wrote, its console a fifo (console.in) and its output console.out — in a
# network namespace of its own when the kernel allows one without root:
# loopback and nothing else, so nothing can reach the network whatever the
# configuration says.
start_server() {
    server_dir="$1"
    local launcher=() ip_cmd
    ip_cmd="$(command -v ip || echo /usr/sbin/ip)"
    if [[ ${netns} -eq 1 ]] && [[ -x "${ip_cmd}" ]] &&
        unshare -rn "${ip_cmd}" link set lo up >/dev/null 2>&1; then
        launcher=(unshare -rn sh -c '"$0" link set lo up && exec "$@"' "${ip_cmd}")
        echo "network: a namespace of its own, loopback only"
    else
        echo "network: the host's (no unprivileged network namespace here, or --no-netns); hermetic by configuration alone"
    fi

    mkfifo "${server_dir}/console.in"
    exec {console_fd}<>"${server_dir}/console.in"
    # there before the server is, so the first look for its lines finds a file
    : >"${server_dir}/console.out"
    (
        cd "${server_dir}"
        exec setsid env -i HOME="${server_dir}" PATH=/usr/bin:/bin LANG=C.UTF-8 TMPDIR="${server_dir}/tmp" \
            PHPRC="${server_dir}/php.ini" PHP_INI_SCAN_DIR= \
            "${launcher[@]}" "${php_bin}" "${phar}" --no-wizard --disable-ansi \
            --data="${server_dir}" --plugins="${server_dir}/plugins"
    ) <"${server_dir}/console.in" >"${server_dir}/console.out" 2>&1 &
    server_pid=$!
    # shellcheck disable=SC2064 # expand now: these are this run's
    trap "kill -TERM -- -${server_pid} 2>/dev/null || true; exec {console_fd}>&-" EXIT
}

# console <line>: types a line at the server's console.
console() {
    printf '%s\n' "$1" >&"${console_fd}"
}

# wait_for <ERE>... <seconds>: until console.out has a line matching each
# pattern, 0; the server exited first, 1; the time ran out, 2.
wait_for() {
    local patterns=("${@:1:$#-1}") limit="${*: -1}" started=${SECONDS} pattern found
    while :; do
        found=1
        for pattern in "${patterns[@]}"; do
            grep -Eq -- "${pattern}" "${server_dir}/console.out" || found=0
        done
        [[ ${found} -eq 1 ]] && return 0
        kill -0 "${server_pid}" 2>/dev/null || return 1
        ((SECONDS - started < limit)) || return 2
        sleep 1
    done
}

# stop_server: the console's stop, if the server is still running, then up
# to 180 s for it to exit before it is killed. Sets server_rc and
# server_stopped (1 only when it stopped on the console's stop).
stop_server() {
    server_rc=0
    server_stopped=0
    if kill -0 "${server_pid}" 2>/dev/null; then
        console stop
        local waited=${SECONDS}
        while kill -0 "${server_pid}" 2>/dev/null && ((SECONDS - waited < 180)); do
            sleep 1
        done
        if kill -0 "${server_pid}" 2>/dev/null; then
            kill -KILL -- "-${server_pid}" 2>/dev/null || true
        else
            server_stopped=1
        fi
    fi
    wait "${server_pid}" || server_rc=$?
    trap - EXIT
    exec {console_fd}>&-
}

# epoch milliseconds of a server.log line's "YYYY-MM-DD [HH:MM:SS.mmm]" stamp
log_stamp_ms() {
    local stamp
    stamp="$(sed -nE 's/^([0-9]{4}-[0-9]{2}-[0-9]{2}) \[([0-9:.]+)\].*/\1 \2/p' <<<"$1")"
    [[ -n "${stamp}" ]] && date -d "${stamp}" +%s%3N
}

readonly spawn_re='Generating spawn terrain: ([0-9]+) / \1 \(100%\)'

# check_server <world>: what a stopped server left in its log and its
# directory, reported; each failure appended to the caller's failures.
check_server() {
    local world="$1" dir="${server_dir}"
    local server_log="${dir}/server.log"
    [[ -f "${server_log}" ]] || server_log="${dir}/console.out"
    echo "console stop $([[ ${server_stopped} -eq 1 ]] && echo "returned" || echo "DID NOT return"); exit code ${server_rc}"
    [[ ${server_stopped} -eq 1 ]] || failures+=("the server did not stop on the console's stop")
    [[ ${server_rc} -eq 0 ]] || failures+=("the server exited ${server_rc}")

    local line
    for line in "Loading Stratum v" "Enabling Stratum v" "Preparing world \"${world}\"" "Stopping the server" "Disabling Stratum v" "Unloading world \"${world}\"" "Stopping other threads"; do
        grep -q "${line}" "${server_log}" || failures+=("server.log never says '${line}'")
    done

    # Loopback and nothing else: the one network interface on 127.0.0.1 at
    # this server's port, no other (IPv6 off), and no Query listener.
    local interfaces
    # the message alone, after the stamp and the "[Server thread/INFO]: " tag
    interfaces="$(grep -E 'network interface running on|Query listener running on' "${server_log}" | sed -E 's/^.*\]: //' || true)"
    echo "network interfaces: ${interfaces//$'\n'/; }"
    grep -q "Minecraft network interface running on 127.0.0.1:${port}\$" <<<"${interfaces}" ||
        failures+=("server.log never says 'Minecraft network interface running on 127.0.0.1:${port}'")
    local other
    other="$(grep -v "^Minecraft network interface running on 127.0.0.1:${port}\$" <<<"${interfaces}" || true)"
    [[ -z "${other}" ]] || failures+=("a network interface other than 127.0.0.1:${port}, or a Query listener:"$'\n'"${other}")

    # Counted as PocketMine-MP logs it, before the generator is constructed
    # there: a registration that then fails still counts. None at all is a
    # count of 0 and a failure below, never grep's exit status ending the
    # script under pipefail before anything is reported.
    local registered
    registered="$({ grep -oE 'Registering generator on worker [0-9]+' "${server_log}" || true; } | sort -u | wc -l | tr -d ' ')"
    echo "generator registration started on ${registered} async worker(s) (pool size ${async_workers})"
    [[ "${registered}" -ge 1 ]] || failures+=("the generator was never registered on a worker")

    local begin end
    begin="$(grep -m1 "Spawn terrain for world \"${world}\" is being generated in the background" "${server_log}" || true)"
    end="$(grep -m1 -E "${spawn_re}" "${server_log}" || true)"
    if [[ -n "${begin}" && -n "${end}" ]]; then
        local ms=$(($(log_stamp_ms "${end}") - $(log_stamp_ms "${begin}")))
        echo "spawn generation: $(sed -nE 's/.*Generating spawn terrain: ([0-9]+) .*/\1/p' <<<"${end}") chunks populated in $((ms / 1000)).$(printf '%03d' $((ms % 1000)))s wall"
    fi
    grep -m1 'Done (' "${server_log}" | sed 's/^/  /' || true
    # PocketMine-MP redoing population whose 3x3 a block change touched
    # while it ran, and main-thread ticks over budget. Reported; a failure
    # only above --max-discards.
    local discards
    discards="$(grep -c 'Discarding population result' "${server_log}" || true)"
    echo "population results discarded because the terrain changed while populating: ${discards}"
    if [[ -n "${max_discards}" && "${discards}" -gt "${max_discards}" ]]; then
        failures+=("${discards} population results discarded, more than --max-discards ${max_discards}")
    fi
    echo "main-thread ticks over budget: $(grep -c 'Tick took too long' "${server_log}" || true)"

    local crashes=0
    if [[ -d "${dir}/crashdumps" ]]; then
        crashes="$(find "${dir}/crashdumps" -type f | wc -l | tr -d ' ')"
    fi
    echo "crashdumps: ${crashes}"
    [[ "${crashes}" -eq 0 ]] || failures+=("${crashes} crashdump(s) in ${dir}/crashdumps")

    local bad
    bad="$(grep -E '/(EMERGENCY|ALERT|CRITICAL|ERROR)\]' "${server_log}" || true)"
    [[ -z "${bad}" ]] || failures+=("server.log has errors:"$'\n'"${bad}")
    bad="$(grep -Eh 'PHP (Fatal error|Warning|Notice|Deprecated)|^(Fatal error|Warning|Notice|Deprecated):|E_(USER_)?(WARNING|NOTICE|DEPRECATED)|Exception' "${server_log}" "${dir}/console.out" || true)"
    [[ -z "${bad}" ]] || failures+=("PHP diagnostics or exceptions:"$'\n'"${bad}")

    local warnings fallbacks
    warnings="$(grep -E '/WARNING\]' "${server_log}" || true)"
    fallbacks="$(grep -c 'Stratum: PocketMine-MP cannot place' <<<"${warnings}" || true)"
    echo "the plugin's documented fallback warnings: ${fallbacks}"
    grep 'Stratum: PocketMine-MP cannot place' <<<"${warnings}" | sed -E 's/.*cannot place ([^ ]+) .*using (.*) for it.*/  \1 -> \2/' | sort -u || true
    bad="$(grep -v 'Stratum: PocketMine-MP cannot place' <<<"${warnings}" | grep -i 'stratum' || true)"
    [[ -z "${bad}" ]] || failures+=("the plugin warned:"$'\n'"${bad}")
    echo "PocketMine-MP's own warnings:"
    grep -v 'Stratum: PocketMine-MP cannot place' <<<"${warnings}" | grep -vi 'stratum' | sed -E 's/^[^]]*\] /  /' || true
}

# inspect <world> <options> [inspect_world.php options]: every chunk on disk
# against what the engine generates for it; a failure appended to failures.
inspect() {
    local world="$1" options="$2"
    shift 2
    echo "on disk, and against what the engine generates for it:"
    local inspect_rc=0
    evidence_php "${evidence}/inspect_world.php" --phar="${phar}" --world="${server_dir}/worlds/${world}" \
        --generator=stratum --options="${options}" --seed="${seed}" "$@" | sed 's/^/  /' || inspect_rc=$?
    [[ ${inspect_rc} -eq 0 ]] || failures+=("the world on disk is incomplete, or not what the engine generates for it")
}

# finish <own_dir>: removes what the run made unless --keep (the work
# directory too when the tool made it, keeping server.log beside it), and
# reports.
finish() {
    local own_dir="$1" dir="${server_dir}"
    if [[ ${keep} -eq 0 ]]; then
        rm -rf "${dir}/worlds" "${dir}/plugins" "${dir}/tmp" "${dir}/console.in"
        if [[ ${own_dir} -eq 1 ]]; then
            cp "${dir}/server.log" "${dir}.server.log" 2>/dev/null && echo "server.log kept at ${dir}.server.log"
            rm -rf "${dir}"
        fi
    fi
    if [[ ${#failures[@]} -gt 0 ]]; then
        printf 'FAIL: %s\n' "${failures[@]}"
        [[ ${keep} -eq 1 || ${own_dir} -eq 0 ]] && echo "server directory: ${dir}"
        exit 1
    fi
    echo "RESULT: PASS"
}

# --- smoke --------------------------------------------------------------------

cmd_smoke() {
    parse_options "$@"
    require_cache
    require_so "${so}"
    require_version_root "${version_root}"
    local settings biomes
    read -r settings biomes < <(dimension_pair)
    local world="stratum_${dimension}"
    local own_dir=0
    if [[ -z "${work_dir}" ]]; then
        work_dir="$(mktemp -d "${TMPDIR:-/tmp}/stratum-pmmp-smoke.XXXXXX")"
        own_dir=1
    fi
    write_server_dir "${work_dir}"
    local dir
    dir="$(cd "${work_dir}" && pwd)"
    local options
    options="$(cat "${dir}/generator-options.json")"

    start_server "${dir}"
    local started=${SECONDS} outcome="spawn"
    wait_for "${spawn_re}" 'Done \(' "${timeout}" || case $? in
        1) outcome="exited" ;;
        *) outcome="timeout" ;;
    esac
    local spawn_seen=$((SECONDS - started))
    stop_server

    failures=()
    echo "PocketMine-MP ${PMMP_VERSION}, headless; world ${world} (${settings} / ${biomes}), seed ${seed}; async-workers ${async_workers}"
    echo "server: ${outcome} after ${spawn_seen}s"
    [[ "${outcome}" == "spawn" ]] || failures+=("the spawn area never finished generating (${outcome})")
    if [[ "${dimension}" == "end" ]]; then
        grep -q "\[StratumEvidence\] world \"${world}\" created; its spawn set to 0 70 0" "${dir}/server.log" ||
            failures+=("the evidence plugin never set the End's spawn over the main island")
    fi
    check_server "${world}"
    inspect "${world}" "${options}"
    finish "${own_dir}"
}

# --- observe --------------------------------------------------------------------

# the latest `stratumevidence status` line's "last given a task at T, now N", as "T N"
last_status() {
    grep 'status: async workers running' "${server_dir}/console.out" | tail -1 |
        sed -nE 's/.*last given a task at ([0-9]+), now ([0-9]+).*/\1 \2/p'
}

# status_count: how many `stratumevidence status` lines the server has printed
status_count() {
    grep -c 'status: async workers running' "${server_dir}/console.out" || true
}

# ask_status: types `stratumevidence status` and waits for its line.
ask_status() {
    local before
    before="$(status_count)"
    console "stratumevidence status"
    local waited=${SECONDS}
    while [[ "$(status_count)" -le "${before}" ]]; do
        kill -0 "${server_pid}" 2>/dev/null || return 1
        ((SECONDS - waited < 60)) || return 2
        sleep 1
    done
}

cmd_observe() {
    parse_options "$@"
    require_cache
    require_so "${so}"
    require_version_root "${version_root}"
    [[ "${dimension}" == "overworld" ]] ||
        die "observe runs the overworld, whose aquifer fluid the engine marks for updates; not --dimension ${dimension}"
    local settings biomes
    read -r settings biomes < <(dimension_pair)
    local world="stratum_${dimension}"
    local own_dir=0
    if [[ -z "${work_dir}" ]]; then
        work_dir="$(mktemp -d "${TMPDIR:-/tmp}/stratum-pmmp-observe.XXXXXX")"
        own_dir=1
    fi
    write_server_dir "${work_dir}" observe
    local dir
    dir="$(cd "${work_dir}" && pwd)"
    local options
    options="$(cat "${dir}/generator-options.json")"

    failures=()
    start_server "${dir}"
    local started=${SECONDS} outcome="spawn" step=""
    wait_for "${spawn_re}" 'Done \(' "${timeout}" || case $? in
        1) outcome="exited" ;;
        *) outcome="timeout" ;;
    esac
    echo "PocketMine-MP ${PMMP_VERSION}, headless, observed; world ${world} (${settings} / ${biomes}), seed ${seed}; async-workers ${async_workers}"
    echo "server: ${outcome} after $((SECONDS - started))s"

    if [[ "${outcome}" == "spawn" ]]; then
        # Every worker idle for the 300 seconds AsyncPool::shutdownUnusedWorkers()
        # asks for (lastUsed + 300 < time()), as the evidence plugin reads
        # each worker's lastUsed; waited for, and read again, until it holds.
        local last now waited_from=${SECONDS}
        step="status"
        while ask_status; do
            read -r last now < <(last_status) || break
            if ((now > last + 300)); then
                step=""
                break
            fi
            if ((SECONDS - waited_from > 900)); then
                step="idle"
                break
            fi
            echo "waiting $((last + 302 - now))s for every async worker to have been idle 300s"
            sleep $((last + 302 - now))
        done
        if [[ -z "${step}" ]]; then
            # The real trigger: the console's gc, which calls
            # MemoryManager::triggerGarbageCollector() — what the periodic
            # garbage collection (memory.garbage-collection.period) calls.
            console "gc"
            step="gc"
            if wait_for 'Garbage collection result' 60 && ask_status; then
                console "stratumevidence populate"
                step="populate"
                if wait_for 'populate: (all [0-9]+ chunk\(s\) populated|ordering the population of 0 chunk)' 600; then
                    # time for the fluid updates to run, and for any
                    # scheduled later than the population to be seen
                    sleep 15
                    step=""
                fi
            fi
        fi
    fi
    stop_server

    [[ "${outcome}" == "spawn" ]] || failures+=("the spawn area never finished generating (${outcome})")
    [[ -z "${step}" ]] || failures+=("the observation stopped at its ${step} step")
    check_server "${world}"
    local marked="${dir}/fluid-updates.json"
    inspect "${world}" "${options}" --fluid-updates="${marked}"
    echo "observed from inside the server:"
    local observe_rc=0
    evidence_php "${evidence}/check_observation.php" --server-log="${dir}/server.log" \
        --report="${dir}/stratum-evidence-report.json" --fluid-updates="${marked}" --world="${world}" |
        sed 's/^/  /' || observe_rc=$?
    [[ ${observe_rc} -eq 0 ]] || failures+=("what the server was observed doing is not what the plugin needs (listed above)")
    finish "${own_dir}"
}

# --- main -----------------------------------------------------------------------

command="${1:-}"
[[ $# -gt 0 ]] && shift
case "${command}" in
    "" | --with-debug-symbols)
        install_all "${command}"
        log "PocketMine-MP ${PMMP_VERSION}: ${phar}"
        log "its PHP: $("${php_bin}" -n -r 'echo PHP_VERSION, PHP_ZTS ? " ZTS" : " NTS", PHP_DEBUG ? " debug" : "";') at ${php_bin}"
        ;;
    --print-php) install_all; echo "${php_bin}" ;;
    --print-phar) install_all; echo "${phar}" ;;
    --print-dir) echo "${cache_dir}" ;;
    server) cmd_server "$@" ;;
    check-load) parse_options "$@"; cmd_check_load ;;
    phpt)
        parse_options "$@"
        require_cache
        require_so "${so}"
        [[ -n "${build_php_config}" ]] || die "--build-php-config is required: its PHP's run-tests.php drives the tests"
        [[ -n "${fixtures_dir}" ]] || die "--fixtures-dir is required"
        require_version_root "${fixtures_dir}/1.21.11"
        [[ ${#rest[@]} -gt 0 ]] || die "phpt needs test directories after --"
        # tools/php-dev's run-tests.php, from PHP's official source: run by
        # PocketMine-MP's php, and running the tests under it, but not a
        # script out of the tarball.
        run_tests="$("${build_php_config}" --prefix)/lib/php/build/run-tests.php"
        [[ -f "${run_tests}" ]] || die "no run-tests.php at ${run_tests}"
        echo "run-tests.php: ${run_tests}"
        STRATUM_FIXTURES_DIR="${fixtures_dir}" NO_INTERACTION=1 exec "${repo_root}/tools/run-phpt" \
            "${php_bin}" "${run_tests}" --show-diff -n -d extension="${so}" -- "${rest[@]}"
        ;;
    census-blocks)
        parse_options "$@"
        require_cache
        require_so "${so}"
        require_version_root "${version_root}"
        report_arg=()
        [[ -z "${report}" ]] || report_arg=(--report="${report}")
        evidence_php "${evidence}/census_blocks.php" --phar="${phar}" --version-root="${version_root}" \
            "${report_arg[@]}"
        ;;
    census-biomes)
        parse_options "$@"
        require_cache
        require_so "${so}"
        require_version_root "${version_root}"
        evidence_php "${evidence}/census_biomes.php" --phar="${phar}" --version-root="${version_root}" \
            --biome-table="${repo_root}/lib/mapping/src/biome_table.inc"
        ;;
    threads)
        parse_options "$@"
        require_cache
        require_so "${so}"
        require_version_root "${version_root}"
        evidence_php "${evidence}/threads.php" --phar="${phar}" --version-root="${version_root}"
        ;;
    smoke) cmd_smoke "$@" ;;
    observe) cmd_observe "$@" ;;
    *)
        sed -n '/^# Usage:/,/^# The checks/p' "$0" | sed 's/^# \{0,1\}//' >&2
        exit 2
        ;;
esac
