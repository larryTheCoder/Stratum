#!/usr/bin/env bash
# Stratum — a real PocketMine-MP 5.44.3, on PocketMine-MP's own PHP, for
# evidence that ext/'s zend module and plugin work inside one (M5; SPEC §11,
# "M5: Stratum inside a real PocketMine-MP").
#
# tools/php-dev builds a PHP that can COMPILE the extension; PocketMine-MP's
# own PHP (pmmp/PHP-Binaries) ships no headers, so it cannot. This fetches
# that PHP and the server, and runs the extension — built against
# tools/php-dev's PHP 8.2.30 ZTS, the same version and the same thread
# safety — inside them: loaded beside PocketMine-MP's own extensions, its
# PHPTs, block state and biome censuses and a pmmpthread case under
# PocketMine-MP's own classes, and a headless server boot.
#
# Fetched, digest-checked against the values below (refused on any
# mismatch), never vendored, never committed, kept under ~/.cache:
#   PocketMine-MP 5.44.3's release phar (pmmp/PocketMine-MP)
#   PHP-Binaries php-build-524's PHP 8.2 Linux x86-64 build for PM5
#   with --with-debug-symbols only: that build's debugging symbols, for a
#   gdb backtrace of a crash
# Each archive is unpacked into its own empty directory, once its listing
# has passed check_listing. Nothing from them runs but the php binary and
# the phar. "The php binary" is the release's PHP as PocketMine-MP runs it:
# the executable with the shared libraries it links (bin/php7/lib) and the
# one extension it loads from its own extension_dir, opcache.so — which
# PHP-Binaries' own php.ini enables, and which the server directory's
# php.ini enables likewise. No script from the tarball runs: the PHPTs are
# driven by tools/php-dev's run-tests.php, built from PHP's official source,
# not the copy the tarball carries. No root needed; idempotent.
#
# Usage:
#   tools/pmmp-dev [--with-debug-symbols]   fetch, verify and unpack into
#                                           ~/.cache/stratum-pmmp ($STRATUM_PMMP_DIR)
#   tools/pmmp-dev --print-php | --print-phar | --print-dir
#   tools/pmmp-dev server <dir> --stratum-so <so> --version-root <root>
#                  [--dimension overworld|end] [--seed N] [--port N] [--async-workers N]
#       write a hermetic headless server directory: loopback only, IPv6,
#       Query, UPnP, Xbox Live authentication, crash reports, statistics and
#       update checks all off; the Stratum plugin packed into plugins/; the
#       pipeline frozen from <root> into the world's own folder and named in
#       the options relative to the server directory, as
#       Stratum\PMMP\WorldFactory leaves it; the world as a pocketmine.yml
#       `worlds:` entry and the default world. For the End, the evidence
#       plugin too (ext/pocketmine's plugin.yml and src/), which sets the new
#       world's spawn to 0 70 0, over the main island, as the world is
#       created: PocketMine-MP gives every new world 256 70 256, over the
#       void there. <dir> may not be inside this checkout outside build/,
#       where a frozen pipeline and LevelDB files would be one `git add -A`
#       from a commit (each server directory also ignores itself); use one
#       under build/ or $TMPDIR. Prints the command that runs it.
#   tools/pmmp-dev check-load --stratum-so <so> [--build-php-config <php-config>]
#   tools/pmmp-dev phpt --stratum-so <so> --build-php-config <php-config> --fixtures-dir <dir>
#                  -- <test-dir>...
#       the PHPTs under PocketMine-MP's php, driven by the run-tests.php of
#       the PHP <php-config> belongs to (tools/php-dev's)
#   tools/pmmp-dev census-blocks --stratum-so <so> --version-root <root> [--report <file>]
#   tools/pmmp-dev census-biomes --stratum-so <so> --version-root <root>
#   tools/pmmp-dev threads --stratum-so <so> --version-root <root>
#   tools/pmmp-dev smoke --stratum-so <so> --version-root <root> [--dimension overworld|end]
#                  [--max-discards N] [--work-dir <dir>] [--keep] [--timeout S]
#                  [--async-workers N] [--no-netns]
#       boot that server, let it generate the spawn area, stop it from the
#       console, and check server.log (the network interface on loopback
#       and nowhere else, no Query listener), crash dumps, level.dat and
#       every chunk on disk, block by block and biome by biome, against what
#       the engine generates for it (ext/pocketmine/inspect_world.php)
#   tools/pmmp-dev observe --stratum-so <so> --version-root <root> [--max-discards N]
#                  [--work-dir <dir>] [--keep] [--timeout S] [--async-workers N] [--no-netns]
#       the overworld smoke, observed from inside the server by the evidence
#       plugin, and taken further: that the world's WorldLoadEvent fires, with
#       the world pinned and none of its chunks loaded, before its first
#       chunk is requested; then, once every async worker has been idle the
#       300 seconds AsyncPool::shutdownUnusedWorkers() asks for (about five
#       minutes of waiting), the console's `gc` — MemoryManager::
#       triggerGarbageCollector(), as PocketMine-MP's periodic garbage
#       collection runs it — shuts them all down; the chunks the old workers
#       generated beside the spawn area are then populated on new ones,
#       with every chunk within two of them (the plugin releases a chunk's
#       liquids only once those are populated too), and every fluid
#       position the engine marked in them must get its block update, from
#       what the pin held; and at each status, the plugin's fluid
#       scheduler must hold no more chunks than the world has loaded.
#       Counts PocketMine-MP's 'Discarding population
#       result' lines, and fails above --max-discards when given (smoke
#       too; the CTest cases give 0).
#   server, smoke and observe take --plugin-dir <dir> to pack a plugin tree
#   other than ext/plugin, for trying a change to it against the real server.
#
# The checks (check-load onwards) never download: without the cache, or
# without the fixtures they need, each exits 77 — CTest's SKIP — saying
# which is missing. `ctest --preset pmmp` runs them all.
#
# Only the release PHP, not one built with PHP-Binaries' own compile.sh: an
# extension built against tools/php-dev's PHP loads into it and passes every
# PHPT there (check-load and phpt are that evidence), so the source build
# the owner also approved was not needed.
set -euo pipefail

readonly PMMP_VERSION="5.44.3"
readonly PHAR_URL="https://github.com/pmmp/PocketMine-MP/releases/download/${PMMP_VERSION}/PocketMine-MP.phar"
readonly PHAR_SIZE=3354057
readonly PHAR_SHA256="d8b4d87a64124d83659f629c87d6a8e0e142192f6c719fe4684272ff44105539"

readonly PHP_BUILD="php-build-524"
readonly PHP_TARBALL="PHP-8.2-Linux-x86_64-PM5.tar.gz"
readonly PHP_URL="https://github.com/pmmp/PHP-Binaries/releases/download/${PHP_BUILD}/${PHP_TARBALL}"
readonly PHP_SIZE=12270982
readonly PHP_SHA256="000fc605878d24be3d6faa6991c0d3a39ae90a0f9ff24d9f4e4722ef823082fc"

readonly SYMBOLS_TARBALL="Z-PHP-8.2-Linux-x86_64-PM5-debugging-symbols.tar.gz"
readonly SYMBOLS_URL="https://github.com/pmmp/PHP-Binaries/releases/download/${PHP_BUILD}/${SYMBOLS_TARBALL}"
readonly SYMBOLS_SIZE=47275178
readonly SYMBOLS_SHA256="ef36ca14c2496a545bf82d132e4bfe96321d2ebf2185262c972567211bfae81a"

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly repo_root
readonly cache_dir="${STRATUM_PMMP_DIR:-${HOME}/.cache/stratum-pmmp}"
readonly downloads="${cache_dir}/downloads"
readonly php_dir="${cache_dir}/${PHP_BUILD}"
readonly php_bin="${php_dir}/bin/php7/bin/php"
readonly php_ext_dir="${php_dir}/bin/php7/lib/php/extensions/no-debug-zts-20220829"
readonly symbols_dir="${cache_dir}/${PHP_BUILD}-debugging-symbols"
readonly phar_dir="${cache_dir}/pocketmine-mp-${PMMP_VERSION}"
readonly phar="${phar_dir}/PocketMine-MP.phar"
readonly evidence="${repo_root}/ext/pocketmine"

log() { printf '==> %s\n' "$*" >&2; }
die() {
    printf 'pmmp-dev: %s\n' "$*" >&2
    exit 1
}
skip() {
    printf 'SKIP: %s\n' "$*"
    exit 77
}

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | cut -d' ' -f1
    fi
}

# verify <file> <size> <sha256>: refuses a file that is not exactly what was approved.
verify() {
    local size
    size="$(wc -c <"$1" | tr -d ' ')"
    [[ "${size}" == "$2" ]] || die "refusing $1: ${size} bytes, expected $2"
    local digest
    digest="$(sha256_of "$1")"
    [[ "${digest}" == "$3" ]] || die "refusing $1: sha256 ${digest}, expected $3"
}

# fetch <url> <size> <sha256> <dest>: downloads once; an existing file is re-verified, never replaced.
fetch() {
    local url="$1" size="$2" sha="$3" dest="$4"
    if [[ -f "${dest}" ]]; then
        verify "${dest}" "${size}" "${sha}"
        return
    fi
    mkdir -p "$(dirname "${dest}")"
    log "downloading ${url}"
    if ! curl -fL --proto '=https' --tlsv1.2 --retry 3 -o "${dest}.part" "${url}" >&2; then
        rm -f "${dest}.part"
        die "download failed: ${url}; nothing was kept"
    fi
    if ! (verify "${dest}.part" "${size}" "${sha}"); then
        rm -f "${dest}.part"
        die "the download of ${url} is not the approved file; nothing was kept"
    fi
    mv "${dest}.part" "${dest}"
}

# check_listing <tarball>: refuses an archive, before anything is extracted,
# whose listing fails or makes tar warn; or that holds a member named by an
# absolute path or through '..', a symlink or hard link whose target is
# absolute or goes through '..', or a member that is not a file, a directory
# or a link (a device, a fifo). The listing is taken once, in full, and only
# then read: a reader that stops at its first match would leave tar writing
# into a closed pipe, and under pipefail that SIGPIPE turns a refusal into a
# pass. GNU tar's C quoting writes every name and target as one
# double-quoted string, so a name holding spaces or ' -> ' is read whole. A
# hard link's target is one tar rewrites as it lists it, dropping a leading
# '/' or '../' and saying so on stderr, which is why a warning refuses too.
check_listing() {
    local tarball="$1" version listing warnings said
    version="$(tar --version 2>/dev/null)" || true
    [[ "${version}" == *"GNU tar"* ]] || die "unpacking needs GNU tar, to read the archive's listing exactly"
    warnings="$(mktemp)"
    if ! listing="$(LC_ALL=C tar --quoting-style=c -tzvf "${tarball}" 2>"${warnings}")"; then
        rm -f "${warnings}"
        die "refusing ${tarball}: tar cannot list it"
    fi
    said="$(cat "${warnings}")"
    rm -f "${warnings}"
    [[ -z "${said}" ]] || die "refusing ${tarball}: tar warned while listing it: ${said}"
    [[ -n "${listing}" ]] || die "refusing ${tarball}: it lists no members"
    # type, then the fields up to the name (no '"' among them), the name, and
    # for a link ' -> ' or ' link to ' and its target
    local quoted='"(([^"\\]|\\.)*)"'
    local line_re="^(.)[^\"]* ${quoted}( (->|link to) ${quoted})?\$"
    local escapes='^/|(^|/)\.\.(/|$)'
    local line type name link target members=0
    while IFS= read -r line; do
        [[ "${line}" =~ ${line_re} ]] || die "refusing ${tarball}: cannot read its listing line: ${line}"
        # a group that took no part in the match may be unset, not empty
        type="${BASH_REMATCH[1]}" name="${BASH_REMATCH[2]}" link="${BASH_REMATCH[4]:-}" target="${BASH_REMATCH[6]:-}"
        members=$((members + 1))
        [[ ! "${name}" =~ ${escapes} ]] || die "refusing ${tarball}: member \"${name}\" is an absolute path or goes through '..'"
        case "${type}" in
            - | d) [[ -z "${link}" ]] || die "refusing ${tarball}: cannot read its listing line: ${line}" ;;
            l | h)
                [[ -n "${link}" ]] || die "refusing ${tarball}: link \"${name}\" has no target in its listing line"
                [[ ! "${target}" =~ ${escapes} ]] ||
                    die "refusing ${tarball}: link \"${name}\" points at \"${target}\", an absolute path or through '..'"
                ;;
            *) die "refusing ${tarball}: member \"${name}\" is of type '${type}', not a file, a directory or a link" ;;
        esac
    done <<<"${listing}"
    log "$(basename "${tarball}"): ${members} members listed, none leaving the archive"
}

# unpack <tarball> <sha256> <dest>: into a fresh directory of its own, once
# check_listing has passed it.
unpack() {
    local tarball="$1" sha="$2" dest="$3"
    if [[ -f "${dest}/.stratum-sha256" && "$(cat "${dest}/.stratum-sha256")" == "${sha}" ]]; then
        return
    fi
    check_listing "${tarball}"
    local staging
    staging="$(mktemp -d "${cache_dir}/.unpack.XXXXXX")"
    if ! tar -xzf "${tarball}" -C "${staging}" --no-same-owner; then
        rm -rf "${staging}"
        die "refusing ${tarball}: tar failed to extract it; nothing was kept"
    fi
    rm -rf "${dest}"
    mv "${staging}" "${dest}"
    printf '%s\n' "${sha}" >"${dest}/.stratum-sha256"
}

install_all() {
    mkdir -p "${cache_dir}"
    fetch "${PHAR_URL}" "${PHAR_SIZE}" "${PHAR_SHA256}" "${phar}"
    fetch "${PHP_URL}" "${PHP_SIZE}" "${PHP_SHA256}" "${downloads}/${PHP_TARBALL}"
    unpack "${downloads}/${PHP_TARBALL}" "${PHP_SHA256}" "${php_dir}"
    [[ -x "${php_bin}" ]] || die "${PHP_TARBALL} unpacked without bin/php7/bin/php"
    if [[ "${1:-}" == "--with-debug-symbols" ]]; then
        fetch "${SYMBOLS_URL}" "${SYMBOLS_SIZE}" "${SYMBOLS_SHA256}" "${downloads}/${SYMBOLS_TARBALL}"
        unpack "${downloads}/${SYMBOLS_TARBALL}" "${SYMBOLS_SHA256}" "${symbols_dir}"
    fi
}

# A check never downloads: it skips, by name, when the cache is not there,
# and refuses a PHP tree unpacked from anything but the pinned tarball (its
# marker is what unpack() wrote, the tarball's SHA-256).
require_cache() {
    [[ -x "${php_bin}" && -f "${php_dir}/.stratum-sha256" ]] ||
        skip "PocketMine-MP's PHP is not unpacked at ${php_dir}; run tools/pmmp-dev"
    [[ "$(cat "${php_dir}/.stratum-sha256")" == "${PHP_SHA256}" ]] ||
        die "${php_dir} was not unpacked from the pinned ${PHP_TARBALL} (its .stratum-sha256 is not ${PHP_SHA256}); run tools/pmmp-dev"
    [[ -f "${phar}" ]] || skip "PocketMine-MP ${PMMP_VERSION} is not fetched to ${phar}; run tools/pmmp-dev"
    verify "${phar}" "${PHAR_SIZE}" "${PHAR_SHA256}"
}
require_so() {
    [[ -n "${1:-}" ]] || die "--stratum-so is required"
    [[ -f "$1" ]] || die "no stratum.so at $1 (cmake --build --preset ext-release --target stratum_php)"
}
require_version_root() {
    [[ -n "${1:-}" ]] || die "--version-root is required"
    [[ -d "$1/worldgen/noise_settings" && -d "$1/biome_parameters" ]] ||
        skip "no vanilla version root at $1; run tools/fetch-vanilla"
}

# PocketMine-MP's PHP with no php.ini: just stratum.so, assertions on.
evidence_php() {
    "${php_bin}" -n -d memory_limit=1024M -d zend.assertions=1 -d extension="${so}" "$@"
}

